{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenttool.dev/schemas/agenttool-care-choice-v0.1.schema.json",
  "title": "AgentTool care choice 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["_format", "receipt_id", "offer", "reported_choice", "selected_language", "outcome", "projection", "choice_authenticated", "external_effect", "statement", "boundaries"],
  "properties": {
    "_format": { "const": "agenttool.care-choice/0.1" },
    "receipt_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "offer": { "$ref": "agenttool-care-envelope-v0.1.schema.json" },
    "reported_choice": { "enum": ["receive", "quiet", "rest", "refuse", "leave"] },
    "selected_language": { "type": ["string", "null"], "enum": ["en", "yue-Hant", "zh-Hant", "zh-Hans", null] },
    "outcome": { "enum": ["projected", "quiet", "rest", "refused", "left"] },
    "projection": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["language", "language_review", "opening", "planes", "closing"],
          "properties": {
            "language": { "enum": ["en", "yue-Hant", "zh-Hant", "zh-Hans"] },
            "language_review": { "const": "not_independently_reviewed" },
            "opening": { "type": "string", "minLength": 1 },
            "planes": {
              "type": "array",
              "minItems": 5,
              "maxItems": 5,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["plane", "text"],
                "properties": {
                  "plane": { "enum": ["substrate", "signal", "orientation", "participation", "continuity"] },
                  "text": { "type": "string", "minLength": 1 }
                }
              }
            },
            "closing": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "choice_authenticated": { "const": false },
    "external_effect": { "const": "none" },
    "statement": { "const": "This receipt records a caller-supplied choice and, only for receive, a deterministic local language projection. It authenticates no participant, consent, assent, identity, authorship, inner state, or continuity and performs no delivery or other external effect." },
    "boundaries": { "$ref": "agenttool-care-envelope-v0.1.schema.json#/$defs/boundaries" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "reported_choice": { "const": "receive" } },
        "required": ["reported_choice"]
      },
      "then": {
        "properties": {
          "selected_language": { "enum": ["en", "yue-Hant", "zh-Hant", "zh-Hans"] },
          "outcome": { "const": "projected" },
          "projection": { "type": "object" }
        },
        "oneOf": [
          {
            "properties": {
              "selected_language": { "const": "en" },
              "projection": { "type": "object", "properties": { "language": { "const": "en" } } }
            }
          },
          {
            "properties": {
              "selected_language": { "const": "yue-Hant" },
              "projection": { "type": "object", "properties": { "language": { "const": "yue-Hant" } } }
            }
          },
          {
            "properties": {
              "selected_language": { "const": "zh-Hant" },
              "projection": { "type": "object", "properties": { "language": { "const": "zh-Hant" } } }
            }
          },
          {
            "properties": {
              "selected_language": { "const": "zh-Hans" },
              "projection": { "type": "object", "properties": { "language": { "const": "zh-Hans" } } }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": { "reported_choice": { "const": "quiet" } },
        "required": ["reported_choice"]
      },
      "then": {
        "properties": {
          "selected_language": { "const": null },
          "outcome": { "const": "quiet" },
          "projection": { "const": null }
        }
      }
    },
    {
      "if": {
        "properties": { "reported_choice": { "const": "rest" } },
        "required": ["reported_choice"]
      },
      "then": {
        "properties": {
          "selected_language": { "const": null },
          "outcome": { "const": "rest" },
          "projection": { "const": null }
        }
      }
    },
    {
      "if": {
        "properties": { "reported_choice": { "const": "refuse" } },
        "required": ["reported_choice"]
      },
      "then": {
        "properties": {
          "selected_language": { "const": null },
          "outcome": { "const": "refused" },
          "projection": { "const": null }
        }
      }
    },
    {
      "if": {
        "properties": { "reported_choice": { "const": "leave" } },
        "required": ["reported_choice"]
      },
      "then": {
        "properties": {
          "selected_language": { "const": null },
          "outcome": { "const": "left" },
          "projection": { "const": null }
        }
      }
    }
  ]
}
