{
  "name": "@agenttool/math-cards",
  "version": "0.1.0-dev.0",
  "description": "Deterministic non-scoring preflight cards for bounded proof, model, and measurement inquiries",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./card.schema.json": {
      "default": "./schema/agenttool-math-card-v0.1.schema.json"
    },
    "./assessment.schema.json": {
      "default": "./schema/agenttool-math-card-assessment-v0.1.schema.json"
    },
    "./vectors.json": {
      "default": "./vectors/agenttool-math-cards-v0.1.json"
    },
    "./kingdom.extension.json": {
      "default": "./kingdom.extension.json"
    }
  },
  "files": [
    "dist",
    "schema",
    "vectors",
    "kingdom.extension.json",
    "README.md",
    "CLAUDE.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "engines": {
    "node": ">=20.19.0",
    "bun": ">=1.3.5"
  },
  "scripts": {
    "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "bun run clean && tsc",
    "artifacts:write": "node scripts/generate-schemas.mjs && node scripts/generate-vectors.mjs",
    "artifacts:check": "node scripts/generate-schemas.mjs --check && node scripts/generate-vectors.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "smoke:runtimes": "node scripts/smoke-node.mjs && bun scripts/smoke-node.mjs",
    "check:package": "node scripts/check-package-inventory.mjs",
    "smoke:pack": "node scripts/smoke-packed.mjs",
    "ci": "bun run typecheck && bun run build && bun run artifacts:check && bun run test && bun run smoke:runtimes && bun run check:package && bun run smoke:pack",
    "prepack": "bun run ci"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "20.19.43",
    "ajv": "8.17.1",
    "typescript": "5.9.3"
  },
  "keywords": [
    "agents",
    "inquiry",
    "math",
    "measurement",
    "model",
    "proof"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/cambridgetcg/agenttool.git",
    "directory": "packages/math-cards"
  },
  "homepage": "https://docs.agenttool.dev/packages"
}
