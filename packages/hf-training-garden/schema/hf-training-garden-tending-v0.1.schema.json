{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenttool.dev/schemas/hf-training-garden-tending-v0.1.schema.json",
  "title": "KINGDOM Hugging Face Training Garden tending plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["_format", "plan_id", "garden_scope_ref", "admission_id", "checkpoint_refs", "hub_release", "layers", "garden_reference_draft", "latest_head_selected", "boundaries"],
  "properties": {
    "_format": { "const": "kingdom.hf-training-garden-tending/0.1" },
    "plan_id": { "$ref": "#/$defs/sha256" },
    "garden_scope_ref": { "$ref": "#/$defs/sha256" },
    "admission_id": { "$ref": "#/$defs/sha256" },
    "checkpoint_refs": { "$ref": "#/$defs/sha_array" },
    "hub_release": { "$ref": "#/$defs/hub_release" },
    "layers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bedrock", "soil", "roots", "mycelium", "habitat", "canopy"],
      "properties": {
        "bedrock": { "$ref": "#/$defs/sha_array" },
        "soil": { "$ref": "#/$defs/sha_array" },
        "roots": { "$ref": "#/$defs/sha_array" },
        "mycelium": { "$ref": "#/$defs/sha_array" },
        "habitat": { "$ref": "#/$defs/sha_array" },
        "canopy": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "type": "string", "pattern": "^dataset:[A-Za-z0-9._-]+\/[A-Za-z0-9._-]+@(?:intended|[0-9a-f]{40})$" } }
      }
    },
    "garden_reference_draft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suggested_kind", "artifact_ref", "host_action", "automatic"],
      "properties": {
        "suggested_kind": { "const": "curation" },
        "artifact_ref": { "$ref": "#/$defs/sha256" },
        "host_action": { "const": "persist_artifact_then_add_supported_reference" },
        "automatic": { "const": false }
      }
    },
    "latest_head_selected": { "const": false },
    "boundaries": { "const": {
      "artifact_scope": "portable_reference_plan_only",
      "garden_api_external_hf_reference_supported": false,
      "persists_artifact": false,
      "creates_garden_reference": false,
      "mutates_garden": false,
      "writes_hub": false,
      "verifies_hub_publication": false,
      "network": false,
      "filesystem": false,
      "credential_access": false,
      "provider_compute": false,
      "paid_compute": false,
      "automatic_training": false,
      "automatic_webhook": false,
      "automatic_resume": false,
      "grants_authority": false
    } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "sha_array": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/sha256" } },
    "hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "hub_release": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["repo_id", "state", "revision", "card_sha256", "hash_manifest_sha256"],
          "properties": {
            "repo_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}\/[A-Za-z0-9][A-Za-z0-9._-]{0,95}$" },
            "state": { "const": "intended_identifier_only" },
            "revision": { "type": "null" },
            "card_sha256": { "type": "null" },
            "hash_manifest_sha256": { "type": "null" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["repo_id", "state", "revision", "card_sha256", "hash_manifest_sha256"],
          "properties": {
            "repo_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}\/[A-Za-z0-9][A-Za-z0-9._-]{0,95}$" },
            "state": { "const": "caller_reported_published" },
            "revision": { "$ref": "#/$defs/revision" },
            "card_sha256": { "$ref": "#/$defs/hex" },
            "hash_manifest_sha256": { "$ref": "#/$defs/hex" }
          }
        }
      ]
    }
  }
}
