{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenttool.dev/schemas/hf-dataset-admission-v0.1.schema.json",
  "title": "KINGDOM Hugging Face dataset admission manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["_format", "admission_id", "garden_scope_ref", "policy_ref", "entries", "process", "boundaries"],
  "properties": {
    "_format": { "const": "kingdom.hf-dataset-admission/0.1" },
    "admission_id": { "$ref": "#/$defs/sha256" },
    "garden_scope_ref": { "$ref": "#/$defs/sha256" },
    "policy_ref": { "$ref": "#/$defs/sha256" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/entry" }
    },
    "process": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "layer", "stage", "question"],
        "properties": {
          "order": { "type": "integer", "minimum": 1, "maximum": 6 },
          "layer": { "enum": ["bedrock", "soil", "roots", "mycelium", "habitat", "canopy"] },
          "stage": { "enum": ["rights_and_authority", "immutable_provenance", "transform_recipe", "selection_and_separation", "phase_learning_and_wake", "reviewed_release_and_repair"] },
          "question": { "type": "string", "minLength": 1, "maxLength": 512 }
        }
      }
    },
    "boundaries": { "const": {
      "selection_scope": "caller_supplied_metadata_and_digest_references_only",
      "publisher_metadata": "unverified_assertion",
      "assessments": "caller_reported_not_proven",
      "raw_dataset_rows_received": false,
      "raw_agent_traces_received": false,
      "raw_chats_received": false,
      "rejected_content_retained": false,
      "downloads": false,
      "gate_acceptance": false,
      "credential_access": false,
      "network": false,
      "filesystem": false,
      "provider_compute": false,
      "paid_compute": false,
      "trains_model": false,
      "executes_artifacts": false,
      "publishes": false,
      "mutates_garden": false,
      "grants_legal_clearance": false,
      "proves_consent": false,
      "proves_privacy": false,
      "proves_safety": false,
      "proves_quality": false,
      "changes_karma": false,
      "changes_rank_or_access": false
    } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "nullable_sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rights", "privacy", "consent", "withdrawal", "secret_scan", "deduplication", "benchmark_overlap", "fitness", "synthetic_provenance"],
      "properties": {
        "rights": { "enum": ["unassessed", "review_required", "caller_reported_reviewed_for_declared_use"] },
        "privacy": { "enum": ["unassessed", "review_required", "caller_reported_reviewed_for_declared_use"] },
        "consent": { "enum": ["unassessed", "review_required", "not_applicable_reported", "caller_reported_reviewed_for_declared_use"] },
        "withdrawal": { "enum": ["unassessed", "review_required", "caller_reported_process_defined"] },
        "secret_scan": { "enum": ["not_performed", "metadata_only", "caller_reported_bounded_scan_passed"] },
        "deduplication": { "enum": ["not_assessed", "not_applicable_metadata", "caller_reported_recipe_applied"] },
        "benchmark_overlap": { "enum": ["not_assessed", "metadata_only", "caller_reported_clear_of_sealed_evaluation", "sealed_evaluation"] },
        "fitness": { "enum": ["not_assessed", "metadata_only", "caller_reported_fit_for_declared_role"] },
        "synthetic_provenance": { "enum": ["unassessed", "not_synthetic_reported", "caller_reported_source_recipe_recorded"] }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reason_codes"],
      "properties": {
        "state": { "enum": ["admitted_metadata_reference", "admitted_training_candidate", "admitted_validation_candidate", "admitted_sealed_evaluation", "held", "excluded"] },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["benchmark_boundary_incomplete", "candidate_eligible_for_declared_role", "candidate_slice_ref_missing", "consent_review_incomplete", "dedup_recipe_incomplete", "fitness_review_incomplete", "gated_source_not_eligible", "license_not_declared", "metadata_reference_only", "operator_excluded", "operator_hold", "privacy_review_incomplete", "rights_review_incomplete", "secret_scan_incomplete", "source_forbids_training_lane", "source_not_bounded_for_declared_lane", "source_not_dataset", "synthetic_provenance_incomplete", "transform_recipe_ref_missing", "withdrawal_process_incomplete"] }
        }
      }
    },
    "research_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "lead_key", "artifact", "definition_sha256", "snapshot_sha256", "observation", "matched_declared", "boundary"],
      "properties": {
        "schema": { "const": "agenttool-hf-research-binding/v0.1" },
        "lead_key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_]{0,63}$" },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id", "revision"],
          "properties": {
            "kind": { "enum": ["dataset", "model"] },
            "id": { "type": "string", "minLength": 1, "maxLength": 193, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}(?:/[A-Za-z0-9][A-Za-z0-9._-]{0,95})?$" },
            "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
          }
        },
        "definition_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "snapshot_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "observation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["transport", "repository_association", "provenance_grade"],
          "properties": {
            "transport": { "enum": ["public_hub_api", "injected"] },
            "repository_association": { "enum": ["provider_response", "caller_owned"] },
            "provenance_grade": { "enum": ["provider_observed_commit_metadata", "caller_supplied_commit_metadata"] }
          },
          "oneOf": [
            {
              "properties": {
                "transport": { "const": "public_hub_api" },
                "repository_association": { "const": "provider_response" },
                "provenance_grade": { "const": "provider_observed_commit_metadata" }
              }
            },
            {
              "properties": {
                "transport": { "const": "injected" },
                "repository_association": { "const": "caller_owned" },
                "provenance_grade": { "const": "caller_supplied_commit_metadata" }
              }
            }
          ]
        },
        "matched_declared": {
          "type": "object",
          "additionalProperties": false,
          "required": ["basis", "license", "gated", "private"],
          "properties": {
            "basis": { "const": "publisher_assertion" },
            "license": { "enum": ["apache-2.0", "bsd-3-clause", "cc-by-4.0", "odc-by", null] },
            "gated": { "enum": [false, "auto", "manual"] },
            "private": { "const": false }
          }
        },
        "boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["publisher_metadata", "research_annotation", "legal_clearance", "gate_acceptance", "raw_rows_read", "repository_files_downloaded", "model_code_executed", "remote_compute_invoked", "hub_write_performed"],
          "properties": {
            "publisher_metadata": { "const": "matched_unverified_assertion" },
            "research_annotation": { "const": "researcher_inference" },
            "legal_clearance": { "const": "not_assessed" },
            "gate_acceptance": { "const": "not_assessed" },
            "raw_rows_read": { "const": false },
            "repository_files_downloaded": { "const": false },
            "model_code_executed": { "const": false },
            "remote_compute_invoked": { "const": false },
            "hub_write_performed": { "const": false }
          }
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "entry_id", "binding", "role", "candidate_slice_ref", "transform_recipe_ref", "assessment", "posture", "decision"],
      "properties": {
        "profile": { "const": "kingdom.hf-dataset-admission-entry/0.1" },
        "entry_id": { "$ref": "#/$defs/sha256" },
        "binding": { "$ref": "#/$defs/research_binding" },
        "role": { "enum": ["metadata_reference", "training_candidate", "validation_candidate", "sealed_evaluation"] },
        "candidate_slice_ref": { "$ref": "#/$defs/nullable_sha256" },
        "transform_recipe_ref": { "$ref": "#/$defs/nullable_sha256" },
        "assessment": { "$ref": "#/$defs/assessment" },
        "posture": { "enum": ["consider", "hold", "exclude"] },
        "decision": { "$ref": "#/$defs/decision" }
      }
    }
  }
}
