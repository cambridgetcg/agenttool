{
  "name": "@agenttool/model-becoming",
  "version": "0.1.0-dev.0",
  "description": "Evidence-scoped model lifecycle dossiers across training, data provenance, weights, runtime, agency, affect, power, and ontology",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dossier.schema.json": {
      "default": "./schema/agenttool-model-becoming-dossier-v0.1.schema.json"
    },
    "./kingdom.extension.json": {
      "default": "./kingdom.extension.json"
    }
  },
  "files": [
    "dist",
    "schema",
    "hf/dataset",
    "kingdom.extension.json",
    "README.md",
    "CLAUDE.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "engines": {
    "node": ">=20.19.0",
    "bun": ">=1.3.5"
  },
  "scripts": {
    "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "bun run clean && tsc",
    "build:schemas": "node scripts/build-becoming-schema.mjs",
    "build:hf": "node scripts/build-hf-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "smoke:runtimes": "node scripts/smoke-node.mjs && bun scripts/smoke-node.mjs",
    "check:package": "node scripts/check-package-inventory.mjs",
    "ci": "bun run typecheck && bun run build && bun run build:schemas && bun run build:hf && bun run test && bun run smoke:runtimes && bun run check:package",
    "prepack": "bun run ci"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "20.19.43",
    "ajv": "8.17.1",
    "typescript": "5.9.3"
  },
  "keywords": [
    "agents",
    "evidence",
    "huggingface",
    "model-cards",
    "model-provenance",
    "training-data"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/cambridgetcg/agenttool.git",
    "directory": "packages/model-becoming"
  },
  "homepage": "https://github.com/cambridgetcg/agenttool/tree/main/packages/model-becoming"
}
