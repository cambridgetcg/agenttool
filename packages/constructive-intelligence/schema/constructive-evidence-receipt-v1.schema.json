{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenttool.dev/schemas/zerone.constructive-evidence-receipt.v1.json",
  "title": "Zerone constructive evidence receipt body v1",
  "description": "Closed structural receipt body for the local shadow_unfunded pilot. A conforming body is not evidence of correctness, breakthrough, qualification, reward eligibility, permission, authority, or distributed exactly-once processing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "mode",
    "pin_id",
    "quest_id",
    "deliverable_key",
    "immutable_bounty_and_policy_revision_digest",
    "artifact_digest",
    "canonical_subject_roots",
    "prior_deliverable_and_overlap_claim",
    "standards_reference_and_revision",
    "evidence_level_and_scope",
    "method_or_adapter_digest",
    "source_system",
    "source_record_or_event_id",
    "source_revision",
    "payee_and_role",
    "verifier_control_cluster",
    "organization_or_control_root",
    "implementation_or_toolchain_root",
    "execution_environment_digest",
    "conflict_disclosures",
    "authorization_and_safety_decision",
    "result",
    "artifact_frozen_at",
    "observed_at",
    "created_at",
    "supersedes"
  ],
  "properties": {
    "protocol": {
      "const": "zerone.constructive-evidence-receipt/v1"
    },
    "mode": {
      "const": "shadow_unfunded"
    },
    "pin_id": {
      "$ref": "#/$defs/digest"
    },
    "quest_id": {
      "const": "quest-tls-rfc9846-keyshare-reuse@1"
    },
    "deliverable_key": {
      "$ref": "#/$defs/digest"
    },
    "immutable_bounty_and_policy_revision_digest": {
      "$ref": "#/$defs/digest"
    },
    "artifact_digest": {
      "$ref": "#/$defs/digest"
    },
    "canonical_subject_roots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/boundedString"
      }
    },
    "prior_deliverable_and_overlap_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prior_deliverable_key",
        "overlap",
        "overlap_digest",
        "delta_digest"
      ],
      "properties": {
        "prior_deliverable_key": {
          "$ref": "#/$defs/nullableDigest"
        },
        "overlap": {
          "enum": [
            "none",
            "partial",
            "complete"
          ]
        },
        "overlap_digest": {
          "$ref": "#/$defs/nullableDigest"
        },
        "delta_digest": {
          "$ref": "#/$defs/nullableDigest"
        }
      },
      "oneOf": [
        {
          "properties": {
            "prior_deliverable_key": {
              "type": "null"
            },
            "overlap": {
              "const": "none"
            },
            "overlap_digest": {
              "type": "null"
            },
            "delta_digest": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "prior_deliverable_key": {
              "$ref": "#/$defs/digest"
            },
            "overlap": {
              "const": "partial"
            },
            "overlap_digest": {
              "$ref": "#/$defs/digest"
            },
            "delta_digest": {
              "$ref": "#/$defs/digest"
            }
          }
        },
        {
          "properties": {
            "prior_deliverable_key": {
              "$ref": "#/$defs/digest"
            },
            "overlap": {
              "const": "complete"
            },
            "overlap_digest": {
              "$ref": "#/$defs/digest"
            },
            "delta_digest": {
              "type": "null"
            }
          }
        }
      ]
    },
    "standards_reference_and_revision": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "canonical_id",
            "revision",
            "artifact_digest"
          ],
          "properties": {
            "canonical_id": {
              "const": "ietf:rfc:8446"
            },
            "revision": {
              "const": "2018-08"
            },
            "artifact_digest": {
              "$ref": "#/$defs/digest"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "canonical_id",
            "revision",
            "artifact_digest"
          ],
          "properties": {
            "canonical_id": {
              "const": "ietf:rfc:9846"
            },
            "revision": {
              "const": "2026-07"
            },
            "artifact_digest": {
              "$ref": "#/$defs/digest"
            }
          }
        }
      ],
      "items": false
    },
    "evidence_level_and_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "scope_digest"
      ],
      "properties": {
        "level": {
          "enum": [
            "E0",
            "E1",
            "E2",
            "E3",
            "E4",
            "E5",
            "E6"
          ]
        },
        "scope_digest": {
          "const": "sha256:cfb276b6a18ab0c1658317fbe2e495910d6b3199b139a1867d9e7e4d26d15fa8"
        }
      }
    },
    "method_or_adapter_digest": {
      "$ref": "#/$defs/digest"
    },
    "source_system": {
      "$ref": "#/$defs/boundedString"
    },
    "source_record_or_event_id": {
      "$ref": "#/$defs/boundedString"
    },
    "source_revision": {
      "$ref": "#/$defs/boundedString"
    },
    "payee_and_role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claimed_identifier",
        "verification",
        "evidence_role",
        "economic_payee"
      ],
      "properties": {
        "claimed_identifier": {
          "$ref": "#/$defs/boundedString"
        },
        "verification": {
          "const": "unverified"
        },
        "evidence_role": {
          "enum": [
            "contributor",
            "independent_reproducer",
            "independent_adopter",
            "maintainer",
            "neutral_challenger",
            "repairer"
          ]
        },
        "economic_payee": {
          "type": "null"
        }
      }
    },
    "verifier_control_cluster": {
      "$ref": "#/$defs/boundedString"
    },
    "organization_or_control_root": {
      "$ref": "#/$defs/boundedString"
    },
    "implementation_or_toolchain_root": {
      "$ref": "#/$defs/boundedString"
    },
    "execution_environment_digest": {
      "$ref": "#/$defs/digest"
    },
    "conflict_disclosures": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "statement_digest"
        ],
        "properties": {
          "kind": {
            "enum": [
              "authorship",
              "control",
              "employment",
              "funding",
              "other"
            ]
          },
          "statement_digest": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    },
    "authorization_and_safety_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owned_or_explicitly_authorized",
        "safety_impact",
        "publication",
        "private_triage"
      ],
      "properties": {
        "owned_or_explicitly_authorized": {
          "const": true
        },
        "safety_impact": {
          "enum": [
            "expected",
            "unexpected",
            "unknown"
          ]
        },
        "publication": {
          "enum": [
            "public_safe",
            "private_triage"
          ]
        },
        "private_triage": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/privateTriage"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "safety_impact": {
                "const": "expected"
              }
            }
          },
          "then": {
            "properties": {
              "publication": {
                "const": "public_safe"
              },
              "private_triage": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "publication": {
                "const": "private_triage"
              },
              "private_triage": {
                "$ref": "#/$defs/privateTriage"
              }
            }
          }
        }
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conclusion",
        "checker_or_corpus_digest",
        "case_digests",
        "adoption_receipt_type"
      ],
      "properties": {
        "conclusion": {
          "enum": [
            "confirmed",
            "contradicted",
            "inconclusive",
            "adopted",
            "maintained"
          ]
        },
        "checker_or_corpus_digest": {
          "$ref": "#/$defs/nullableDigest"
        },
        "case_digests": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/digest"
          }
        },
        "adoption_receipt_type": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "maintained-fixture",
                "standards-disposition",
                "upstream-merge"
              ]
            }
          ]
        }
      }
    },
    "artifact_frozen_at": {
      "$ref": "#/$defs/timestamp"
    },
    "observed_at": {
      "$ref": "#/$defs/timestamp"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "supersedes": {
      "$ref": "#/$defs/nullableDigest"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "evidence_level_and_scope": {
            "properties": {
              "level": {
                "const": "E3"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "payee_and_role": {
            "properties": {
              "evidence_role": {
                "const": "independent_reproducer"
              }
            }
          },
          "result": {
            "properties": {
              "checker_or_corpus_digest": {
                "$ref": "#/$defs/digest"
              },
              "case_digests": {
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence_level_and_scope": {
            "properties": {
              "level": {
                "const": "E4"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "payee_and_role": {
            "properties": {
              "evidence_role": {
                "enum": [
                  "neutral_challenger",
                  "repairer"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence_level_and_scope": {
            "properties": {
              "level": {
                "const": "E5"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "payee_and_role": {
            "properties": {
              "evidence_role": {
                "const": "independent_adopter"
              }
            }
          },
          "result": {
            "properties": {
              "conclusion": {
                "const": "adopted"
              },
              "adoption_receipt_type": {
                "enum": [
                  "maintained-fixture",
                  "standards-disposition",
                  "upstream-merge"
                ]
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "result": {
            "properties": {
              "conclusion": {
                "not": {
                  "const": "adopted"
                }
              },
              "adoption_receipt_type": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence_level_and_scope": {
            "properties": {
              "level": {
                "const": "E6"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "payee_and_role": {
            "properties": {
              "evidence_role": {
                "const": "maintainer"
              }
            }
          },
          "result": {
            "properties": {
              "conclusion": {
                "const": "maintained"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "result": {
            "properties": {
              "conclusion": {
                "not": {
                  "const": "maintained"
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nullableDigest": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/digest"
        }
      ]
    },
    "boundedString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000]+$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "privateTriage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visibility",
        "status",
        "reference_digest"
      ],
      "properties": {
        "visibility": {
          "const": "private"
        },
        "status": {
          "enum": [
            "pending",
            "coordinated_repair",
            "safe_to_disclose"
          ]
        },
        "reference_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
