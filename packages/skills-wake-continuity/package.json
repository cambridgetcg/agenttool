{
  "name": "@agenttool/skills-wake-continuity",
  "version": "0.1.0-dev.0",
  "description": "Private reference-only bridge from Skills YUTABASE plans into AFTERGLOW",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./thread.schema.json": {
      "default": "./schema/skills-wake-continuity-thread-v0.1.schema.json"
    },
    "./eight-quiet-stars.schema.json": {
      "default": "./schema/eight-quiet-stars-v0.1.schema.json"
    }
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "CLAUDE.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20.19.0",
    "bun": ">=1.3.5"
  },
  "scripts": {
    "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build:deps": "bun run --cwd ../skills-yutabase build && bun run --cwd ../wake-continuity build",
    "build": "bun run clean && tsc",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "smoke:runtimes": "node scripts/smoke-node.mjs && bun scripts/smoke-node.mjs",
    "check:package": "node scripts/check-package-inventory.mjs",
    "ci": "bun run build:deps && bun run typecheck && bun run test && bun run build && bun run smoke:runtimes && bun run check:package"
  },
  "dependencies": {
    "@agenttool/skills-yutabase": "file:../skills-yutabase",
    "@agenttool/wake-continuity": "file:../wake-continuity"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "20.19.43",
    "ajv": "8.20.0",
    "typescript": "5.9.3"
  },
  "keywords": [
    "agents",
    "afterglow",
    "skills",
    "wake",
    "yutabase"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/cambridgetcg/agenttool.git",
    "directory": "packages/skills-wake-continuity"
  }
}
