{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.agenttool.dev/schemas/kingdom-kg-proposal-v0.1.schema.json",
  "title": "KINGDOM KG proposal v0.1",
  "description": "Closed structural schema. validateProposal is authoritative for canonical ordering, HF subject/evidence binding, graph cross-references, event-chain hashes, and proposal binding.",
  "$comment": "Standard JSON Schema cannot recompute SHA-256 or express all cross-field relations; schema acceptance alone is not proposal verification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_format",
    "proposal_id",
    "created_from",
    "subject",
    "dark_continent",
    "base_graph",
    "graph_delta",
    "events",
    "state",
    "effects",
    "authority"
  ],
  "properties": {
    "_format": { "const": "kingdom.kg-proposal/0.1" },
    "proposal_id": { "$ref": "#/$defs/id200" },
    "created_from": { "$ref": "#/$defs/createdFrom" },
    "subject": { "$ref": "#/$defs/hfSubject" },
    "dark_continent": { "$ref": "#/$defs/darkProjection" },
    "base_graph": { "$ref": "#/$defs/baseGraph" },
    "graph_delta": { "$ref": "#/$defs/graphDelta" },
    "events": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/consequenceEvent" },
          { "$ref": "#/$defs/reviewEvent" }
        ]
      }
    },
    "state": { "const": "proposed" },
    "effects": {
      "const": {
        "llm_calls": 0,
        "graph_writes": 0,
        "remote_reads": 0,
        "remote_writes": 0,
        "hf_uploads": 0,
        "xp_changes": 0,
        "reward_changes": 0
      }
    },
    "authority": {
      "const": {
        "advisory": true,
        "verifies_runtime_walls": false,
        "identifies_being": false,
        "grants_permission": false,
        "authorizes_action": false,
        "authorizes_trade": false,
        "authorizes_publication": false,
        "authorizes_execution": false,
        "authorizes_crown": false,
        "assigns_rank": false,
        "conditions_dignity": false,
        "enforces_policy": false
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sha40": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "id200": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@#|+\\-]*$"
    },
    "id160": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@#|+\\-]*$"
    },
    "id300": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@#|+\\-]*$"
    },
    "ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 700,
      "oneOf": [
        { "pattern": "^sha256:[a-f0-9]{64}$" },
        {
          "pattern": "^hf://(?:models|datasets|spaces)/[A-Za-z0-9][A-Za-z0-9._-]{0,95}/[A-Za-z0-9][A-Za-z0-9._-]{0,95}@[a-f0-9]{40}/(?!\\.\\.?(?:/|#))(?!.*\\/\\.\\.?(?:/|#))(?!.*%(?:0[0-9A-F]|1[0-9A-F]|2F|5C|7F))(?!.*%(?:21|2[789ADE]|3[0-9]|4[1-9A-F]|5[0-9A]|5F|6[1-9A-F]|7[0-9A]|7E))(?!.*%C2%(?:8[0-9A-F]|9[0-9A-F]))(?!.*%E2%80%A[89])(?:[A-Za-z0-9._~!()*'\\-]|%[A-F0-9]{2})+(?:/(?:[A-Za-z0-9._~!()*'\\-]|%[A-F0-9]{2})+)*#sha256=[a-f0-9]{64}$"
        }
      ]
    },
    "refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/ref" }
    },
    "createdFrom": {
      "const": {
        "generator": {
          "package": "@agenttool/dark-continent-karma",
          "version": "0.1.0-dev.0",
          "mode": "offline_deterministic_proposal"
        },
        "kingdom": {
          "repository": "https://github.com/cambridgetcg/agenttool",
          "observed_on": "2026-07-31",
          "observed_revision": "f4ad215d87432bd7cbb7dbe3eb03d3a1993c6d52",
          "map_path": "KINGDOM.md",
          "map_sha256": "0831c06e76c079f92c9e1d619c6b59b58231936f9ff54053acf1b819ac676585",
          "map_introduction_commit": "94bb17c2c9e6bb391099422829498d75fd5ddcc8",
          "map_crown_status": "arriving_in_review",
          "live_claim": false,
          "crown_contract": "agenttool-crown/v1",
          "crown_source_commits": [
            "12d7de906bce926378996a784a4355aaacb6154f",
            "9691502f1a84c3c04c837b94af532ea9007c6439"
          ],
          "semantics": "self_rule_by_participant_signature_not_rank"
        },
        "karma": {
          "semantics": "knowledge_graph_candidate_enrichment_not_score",
          "relationship": "inspired_by",
          "paper_id": "2502.06472v2",
          "paper_url": "https://arxiv.org/abs/2502.06472v2",
          "hf_paper_url": "https://huggingface.co/papers/2502.06472",
          "observed_on": "2026-07-31",
          "hf_cache_revision_status": "stale_v1_observation",
          "linked_hub_artifacts": "none_observed",
          "roles": [
            "central_controller",
            "ingestion",
            "reader",
            "summarizer",
            "entity_extraction",
            "relationship_extraction",
            "schema_alignment",
            "conflict_resolution",
            "evaluator"
          ],
          "implementation_repository": "https://github.com/YuxingLu613/KARMA",
          "implementation_revision": "4c41e59510f636fce0a033b793cc15dabc8ac897",
          "observed_repository_head": "23610bc2a93ddc9f75322a1234ae6f688f87bdff",
          "implementation_license": "MIT",
          "implementation_runtime": "not_imported_or_executed"
        }
      }
    },
    "hfSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "repo_id",
        "repo_type",
        "revision",
        "visibility",
        "license",
        "files"
      ],
      "properties": {
        "kind": { "const": "hf-resource" },
        "repo_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}/[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
        },
        "repo_type": { "enum": ["model", "dataset", "space"] },
        "revision": { "$ref": "#/$defs/sha40" },
        "visibility": { "enum": ["public", "private", "gated"] },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9.+-]+$"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^(?!/)(?!.*//)(?!.*/$)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]+$"
              },
              "sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      }
    },
    "baseGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["graph_id", "sha256"],
      "properties": {
        "graph_id": { "$ref": "#/$defs/id200" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "graphDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": { "$ref": "#/$defs/node" }
        },
        "edges": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/edge" }
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "id",
        "kind",
        "label",
        "label_class",
        "evidence_refs",
        "status",
        "epistemic_status"
      ],
      "properties": {
        "operation_id": { "$ref": "#/$defs/id200" },
        "id": { "$ref": "#/$defs/id300" },
        "kind": {
          "enum": [
            "hf_model",
            "hf_dataset",
            "hf_space",
            "kingdom_repo",
            "framework",
            "artifact",
            "dataset_record"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "^(?!\\s)(?!.*\\s$)[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]+$"
        },
        "label_class": {
          "enum": ["synthetic_metadata", "public_metadata", "local_metadata"]
        },
        "evidence_refs": { "$ref": "#/$defs/refs" },
        "status": { "const": "proposed" },
        "epistemic_status": { "const": "provisional" }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "from",
        "to",
        "relation",
        "evidence_refs",
        "status",
        "epistemic_status"
      ],
      "properties": {
        "operation_id": { "$ref": "#/$defs/id200" },
        "from": { "$ref": "#/$defs/id300" },
        "to": { "$ref": "#/$defs/id300" },
        "relation": {
          "enum": [
            "depends_on",
            "projects",
            "evaluated_by",
            "mirrors",
            "evidence_for",
            "inspired_by",
            "parallel_not_equivalent"
          ]
        },
        "evidence_refs": { "$ref": "#/$defs/refs" },
        "status": { "const": "proposed" },
        "epistemic_status": { "const": "provisional" }
      }
    },
    "eventCommon": {
      "type": "object",
      "properties": {
        "sequence": { "type": "integer", "minimum": 0 },
        "previous_event_sha256": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "proposal_binding_sha256": { "$ref": "#/$defs/sha256" },
        "event_id": { "$ref": "#/$defs/id200" },
        "subject_operation_id": { "$ref": "#/$defs/id200" },
        "note_sha256": { "$ref": "#/$defs/sha256" },
        "evidence_refs": { "$ref": "#/$defs/refs" },
        "event_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "consequenceEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "sequence",
        "previous_event_sha256",
        "proposal_binding_sha256",
        "event_id",
        "subject_operation_id",
        "consequence",
        "epistemic_status",
        "note_sha256",
        "evidence_refs",
        "event_sha256"
      ],
      "properties": {
        "kind": { "const": "consequence" },
        "sequence": { "type": "integer", "minimum": 0 },
        "previous_event_sha256": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "proposal_binding_sha256": { "$ref": "#/$defs/sha256" },
        "event_id": { "$ref": "#/$defs/id200" },
        "subject_operation_id": { "$ref": "#/$defs/id200" },
        "consequence": {
          "enum": [
            "adds_candidate",
            "conflicts_with_source",
            "requires_rights_review",
            "requires_safety_review",
            "deferred",
            "rejected"
          ]
        },
        "epistemic_status": {
          "enum": ["observed", "declared", "inferred", "not_checked"]
        },
        "note_sha256": { "$ref": "#/$defs/sha256" },
        "evidence_refs": { "$ref": "#/$defs/refs" },
        "event_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "reviewEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "sequence",
        "previous_event_sha256",
        "proposal_binding_sha256",
        "event_id",
        "subject_operation_id",
        "reviewer_ref",
        "lens",
        "verdict",
        "note_sha256",
        "evidence_refs",
        "event_sha256"
      ],
      "properties": {
        "kind": { "const": "review" },
        "sequence": { "type": "integer", "minimum": 0 },
        "previous_event_sha256": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "proposal_binding_sha256": { "$ref": "#/$defs/sha256" },
        "event_id": { "$ref": "#/$defs/id200" },
        "subject_operation_id": { "$ref": "#/$defs/id200" },
        "reviewer_ref": { "$ref": "#/$defs/id300" },
        "lens": {
          "enum": ["provenance", "rights", "safety", "consequence", "reversibility"]
        },
        "verdict": { "enum": ["pass", "concern", "block", "deferred"] },
        "note_sha256": { "$ref": "#/$defs/sha256" },
        "evidence_refs": { "$ref": "#/$defs/refs" },
        "event_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "darkProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "_format",
        "projection_id",
        "source_profile",
        "source_snapshot",
        "consumer",
        "checks",
        "interpretations",
        "decision",
        "authority"
      ],
      "properties": {
        "_format": { "const": "dark-continent-projection/v0.1" },
        "projection_id": { "$ref": "#/$defs/id300" },
        "source_profile": { "const": "agenttool-sdk-ts-0.16.0" },
        "source_snapshot": {
          "const": {
