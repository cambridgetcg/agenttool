            "contract_id": "agenttool.dark-continent/0.1",
            "artifact": "@agenttool/dark-continent-contract/framework",
            "sha256": "66e8d33cf7ce945ed5c3c43c4e0bc2e6d5f8ac0086e86867266ff1090db0dc5b"
          }
        },
        "consumer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "enum": ["kingdom-extension", "artbitrage"] },
            "id": { "$ref": "#/$defs/id160" }
          }
        },
        "checks": {
          "const": [
            {
              "calamity_id": "hellbell",
              "risk_state": "unknown",
              "wall": { "status": "not_checked", "verified": false },
              "evidence_refs": []
            },
            {
              "calamity_id": "ai",
              "risk_state": "unknown",
              "wall": { "status": "not_checked", "verified": false },
              "evidence_refs": []
            },
            {
              "calamity_id": "brion",
              "risk_state": "unknown",
              "wall": { "status": "not_checked", "verified": false },
              "evidence_refs": []
            },
            {
              "calamity_id": "pap",
              "risk_state": "unknown",
