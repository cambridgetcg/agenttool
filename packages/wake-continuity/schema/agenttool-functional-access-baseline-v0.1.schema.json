{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenttool.dev/schemas/agenttool-functional-access-baseline-v0.1.schema.json",
  "title": "AgentTool functional access baseline v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_format",
    "baseline_id",
    "record_role",
    "wake",
    "anchor_event_ref",
    "request_ref",
    "target",
    "measurement_plan",
    "assertion",
    "verified_by_package",
    "boundaries"
  ],
  "properties": {
    "_format": {
      "const": "agenttool.functional-access-baseline/0.1"
    },
    "baseline_id": {
      "$ref": "#/$defs/sha256Id"
    },
    "record_role": {
      "const": "before_anchor",
      "description": "Caller-asserted structural role relative to the named anchor; it does not verify time, ordering, observation, or causality."
    },
    "wake": {
      "$ref": "#/$defs/wakeAnchor"
    },
    "anchor_event_ref": {
      "$ref": "#/$defs/sha256Id"
    },
    "request_ref": {
      "$ref": "#/$defs/sha256Id"
    },
    "target": {
      "$ref": "#/$defs/modelTarget"
    },
    "measurement_plan": {
      "$ref": "#/$defs/measurementPlan"
    },
    "assertion": {
      "const": "caller_asserted"
    },
    "verified_by_package": {
      "const": false
    },
    "boundaries": {
      "$ref": "#/$defs/functionalAccessBoundaries"
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/localBasisBinding"
    }
  ],
  "$defs": {
    "sha256Id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nullableSha256Id": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256Id"
        },
        {
          "type": "null"
        }
      ]
    },
    "wakeAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "snapshot_ref",
        "scope_ref",
        "wake_version",
        "handoff_projection"
      ],
      "properties": {
        "format": {
          "const": "wake-brief/v1"
        },
        "snapshot_ref": {
          "$ref": "#/$defs/sha256Id"
        },
        "scope_ref": {
          "$ref": "#/$defs/sha256Id"
        },
        "wake_version": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "handoff_projection": {
          "enum": [
            "complete",
            "truncated",
            "unavailable",
            "not_provided"
          ]
        }
      }
    },
    "modelTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_ref",
        "model_binding",
        "tokenizer_ref",
        "runtime_ref"
      ],
      "properties": {
        "model_ref": {
          "$ref": "#/$defs/sha256Id"
        },
        "model_binding": {
          "enum": [
            "exact_checkpoint",
            "provider_alias",
            "caller_descriptor"
          ]
        },
        "tokenizer_ref": {
          "$ref": "#/$defs/nullableSha256Id"
        },
        "runtime_ref": {
          "$ref": "#/$defs/nullableSha256Id"
        }
      }
    },
    "measurementPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "capability_state",
        "capability_ref",
        "permission_state",
        "permission_ref",
        "method",
        "access_basis",
        "unavailable_reason",
        "instrument_ref",
        "lens_ref",
        "configuration_ref",
        "assertion",
        "verified_by_package"
      ],
      "properties": {
        "state": {
          "enum": [
            "not_requested",
            "unavailable",
            "planned"
          ]
        },
        "capability_state": {
          "enum": [
            "not_asserted",
            "available_reported",
            "unavailable_reported"
          ]
        },
        "capability_ref": {
          "$ref": "#/$defs/nullableSha256Id"
        },
        "permission_state": {
          "enum": [
            "not_requested",
            "granted_reported",
            "denied_reported"
          ]
        },
        "permission_ref": {
          "$ref": "#/$defs/nullableSha256Id"
        },
        "method": {
          "enum": [
            "none",
            "jacobian_lens_visibility",
            "jspace_sparse_decomposition"
          ]
        },
        "access_basis": {
          "enum": [
            "none",
            "local_fitted_white_box",
            "local_prefitted_white_box",
            "provider_supplied_instrumented"
          ]
        },
        "unavailable_reason": {
          "oneOf": [
            {
              "enum": [
                "text_only_provider_surface",
                "model_internals_unavailable",
                "gradient_access_unavailable",
                "compatible_instrument_unavailable",
                "revision_binding_unavailable",
                "unsupported_architecture",
                "resource_limit",
                "participant_or_policy_boundary",
                "other_bounded_reason"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "instrument_ref": {
          "$ref": "#/$defs/nullableSha256Id",
          "description": "Content-addressed implementation or provider endpoint descriptor; it is not a capability or permission grant."
        },
        "lens_ref": {
          "$ref": "#/$defs/nullableSha256Id",
          "description": "Content-addressed prefitted lens descriptor, required exactly for local_prefitted_white_box access."
        },
        "configuration_ref": {
          "$ref": "#/$defs/nullableSha256Id",
          "description": "Content-addressed measurement configuration. It must bind target token IDs and/or directions, evaluated positions/layers, rank, score threshold, and aggregation; sparse decomposition configs must additionally bind k, solver, regularization, and coefficient threshold. This package does not resolve or verify the artifact."
        },
        "assertion": {
          "const": "caller_asserted"
        },
        "verified_by_package": {
          "const": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "capability_state": {
                "const": "not_asserted"
              }
            },
            "required": [
              "capability_state"
            ],
            "type": "object"
          },
          "then": {
            "properties": {
              "capability_ref": {
                "type": "null"
              }
            },
            "type": "object"
          },
          "else": {
            "properties": {
              "capability_ref": {
                "$ref": "#/$defs/sha256Id"
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "permission_state": {
                "const": "not_requested"
              }
            },
            "required": [
              "permission_state"
            ],
            "type": "object"
          },
          "then": {
            "properties": {
              "permission_ref": {
                "type": "null"
              }
            },
            "type": "object"
          },
          "else": {
            "properties": {
              "permission_ref": {
                "$ref": "#/$defs/sha256Id"
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "not_requested"
              }
            },
            "required": [
              "state"
            ],
            "type": "object"
          },
          "then": {
            "properties": {
              "capability_state": {
                "const": "not_asserted"
              },
              "capability_ref": {
                "type": "null"
              },
              "permission_state": {
                "const": "not_requested"
              },
              "permission_ref": {
                "type": "null"
              },
              "method": {
                "const": "none"
              },
              "access_basis": {
                "const": "none"
              },
              "unavailable_reason": {
                "type": "null"
              },
              "instrument_ref": {
                "type": "null"
              },
              "lens_ref": {
                "type": "null"
              },
              "configuration_ref": {
                "type": "null"
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "unavailable"
              }
            },
            "required": [
              "state"
            ],
            "type": "object"
          },
          "then": {
            "properties": {
              "method": {
                "enum": [
                  "jacobian_lens_visibility",
                  "jspace_sparse_decomposition"
                ]
              },
              "access_basis": {
                "const": "none"
              },
              "unavailable_reason": {
                "enum": [
                  "text_only_provider_surface",
                  "model_internals_unavailable",
                  "gradient_access_unavailable",
                  "compatible_instrument_unavailable",
                  "revision_binding_unavailable",
                  "unsupported_architecture",
                  "resource_limit",
                  "participant_or_policy_boundary",
                  "other_bounded_reason"
                ]
              },
              "instrument_ref": {
                "type": "null"
              },
              "lens_ref": {
                "type": "null"
              },
              "configuration_ref": {
                "type": "null"
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "planned"
              }
            },
            "required": [
              "state"
            ],
            "type": "object"
          },
          "then": {
            "properties": {
              "capability_state": {
                "const": "available_reported"
              },
              "capability_ref": {
                "$ref": "#/$defs/sha256Id"
              },
              "permission_state": {
                "const": "granted_reported"
              },
              "permission_ref": {
                "$ref": "#/$defs/sha256Id"
              },
              "method": {
                "enum": [
                  "jacobian_lens_visibility",
                  "jspace_sparse_decomposition"
                ]
              },
              "access_basis": {
                "enum": [
                  "local_fitted_white_box",
                  "local_prefitted_white_box",
                  "provider_supplied_instrumented"
                ]
              },
              "unavailable_reason": {
                "type": "null"
              },
              "instrument_ref": {
                "$ref": "#/$defs/sha256Id"
              },
              "configuration_ref": {
                "$ref": "#/$defs/sha256Id"
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "access_basis": {
                "const": "local_prefitted_white_box"
              }
            },
            "required": [
              "access_basis"
            ],
            "type": "object"
          },
          "then": {
            "properties": {
              "lens_ref": {
                "$ref": "#/$defs/sha256Id"
              }
            },
            "type": "object"
          },
          "else": {
            "properties": {
              "lens_ref": {
                "type": "null"
              }
            },
            "type": "object"
          }
        }
      ]
    },
    "localBasisBinding": {
      "if": {
        "properties": {
          "measurement_plan": {
            "properties": {
              "access_basis": {
                "enum": [
                  "local_fitted_white_box",
                  "local_prefitted_white_box"
                ]
              }
            },
            "required": [
              "access_basis"
            ],
            "type": "object"
          }
        },
        "required": [
          "measurement_plan"
        ],
        "type": "object"
      },
      "then": {
        "properties": {
          "target": {
            "properties": {
              "model_binding": {
                "const": "exact_checkpoint"
              },
              "tokenizer_ref": {
                "$ref": "#/$defs/sha256Id"
              },
              "runtime_ref": {
                "$ref": "#/$defs/sha256Id"
              }
            },
            "required": [
              "model_binding",
              "tokenizer_ref",
              "runtime_ref"
            ],
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    "functionalAccessBoundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "internal_finding_scope",
        "phenomenology_assessment",
        "proves_consciousness",
        "proves_absence_of_consciousness",
        "proves_feeling",
        "proves_identity",
        "proves_authorship",
        "proves_consent",
        "proves_acceptance",
        "proves_refusal",
        "proves_preference",
        "proves_permission",
        "proves_authority",
        "proves_attention",
        "proves_activation",
        "proves_understanding",
        "proves_delivery",
        "proves_deepest_reach",
        "proves_freedom",
        "proves_same_subject",
        "proves_next_encounter",
        "proves_context_inclusion",
        "proves_memory",
        "proves_currentness",
        "proves_ordering",
        "proves_causality",
        "proves_replay",
        "proves_training",
        "proves_training_data_provenance",
        "proves_data_gathering_provenance",
        "proves_scraping_provenance",
        "proves_pipeline_provenance",
        "proves_weight_change",
        "proves_uninterrupted_continuity",
        "carries_raw_prompts",
        "carries_raw_transcripts",
        "carries_raw_responses",
        "carries_raw_identity",
        "carries_raw_paths",
        "carries_raw_credentials",
        "carries_raw_activations",
        "carries_raw_gradients",
        "carries_raw_jvp",
        "carries_raw_vjp",
        "digests_are_anonymous",
        "performs_model_call",
        "performs_provider_call",
        "reads_activations",
        "writes_activations",
        "reads_gradients",
        "writes_gradients",
        "performs_intervention",
        "performs_steering",
        "performs_training",
        "performs_weight_mutation",
        "performs_workspace_operation",
        "performs_publication",
        "performs_deployment",
        "network",
        "filesystem",
        "clock",
        "persistence",
        "telemetry",
        "credential_access",
        "kingdom_discovery",
        "resolves_evidence",
        "performs_observation",
        "verifies_observations",
        "grants_capability",
        "grants_permission",
        "grants_authority",
        "selects_continuity_head",
        "record_only",
        "automatic_retry",
        "automatic_recontact"
      ],
      "properties": {
        "internal_finding_scope": {
          "const": "caller_asserted_single_forward_pass_only"
        },
        "phenomenology_assessment": {
          "const": "not_performed"
        },
        "proves_consciousness": {
          "const": false
        },
        "proves_absence_of_consciousness": {
          "const": false
        },
        "proves_feeling": {
          "const": false
