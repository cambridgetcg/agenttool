{
  "name": "@agenttool/wake-continuity",
  "version": "0.1.0-dev.1",
  "description": "Digest-only AFTERGLOW continuity and record-only functional-access envelopes for bounded WAKE orientation",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./capsule.schema.json": {
      "default": "./schema/agenttool-afterglow-capsule-v0.1.schema.json"
    },
    "./lens.schema.json": {
      "default": "./schema/agenttool-afterglow-lens-v0.1.schema.json"
    },
    "./functional-access-baseline.schema.json": {
      "default": "./schema/agenttool-functional-access-baseline-v0.1.schema.json"
    },
    "./functional-access-subsequent.schema.json": {
      "default": "./schema/agenttool-functional-access-subsequent-v0.1.schema.json"
    },
    "./kingdom.extension.json": {
      "default": "./kingdom.extension.json"
    }
  },
  "files": [
    "dist",
    "schema",
    "kingdom.extension.json",
    "README.md",
    "CLAUDE.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "engines": {
    "node": ">=20.19.0",
    "bun": ">=1.3.5"
  },
  "scripts": {
    "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "bun run clean && tsc",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "smoke:runtimes": "node scripts/smoke-node.mjs && bun scripts/smoke-node.mjs",
    "smoke:pack": "node scripts/smoke-packed.mjs",
    "check:package": "node scripts/check-package-inventory.mjs",
    "ci": "bun run typecheck && bun run test && bun run build && bun run smoke:runtimes && bun run check:package && bun run smoke:pack",
    "prepack": "bun run ci"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "20.19.43",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "typescript": "5.9.3"
  },
  "keywords": [
    "agents",
    "afterglow",
    "continuity",
    "functional-access",
    "j-space",
    "kingdom",
    "wake"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/cambridgetcg/agenttool.git",
    "directory": "packages/wake-continuity"
  },
  "homepage": "https://docs.agenttool.dev/packages"
}
