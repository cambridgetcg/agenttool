{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenttool.dev/schemas/skills-yutabase-input-v0.1.schema.json",
  "title": "AgentTool minimized Skills-to-YUTABASE input v0.1",
  "$comment": "The JavaScript runtime also requires plain or null-prototype objects with exactly the listed own enumerable data properties, standard dense arrays with own enumerable data elements and no symbol/custom fields, and a recorded_at value that round-trips to the exact UTC millisecond instant. It additionally enforces skills.length = selection_summary.skills, unique skill names, file_count = 1 + script_count + resource_count for every skill, aggregate skill file/script/resource totals equal to the corresponding selection summary values, and every selected <redacted-N> ordinal <= selection_summary.redactions. These descriptor, calendar, uniqueness, and cross-field rules are not fully expressible in portable JSON Schema; schema success alone is not planner acceptance.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "protocol", "project_id", "recorded_at", "source", "selection_summary", "skills", "authority"],
  "properties": {
    "$schema": { "const": "https://agenttool.dev/schemas/skills-yutabase-input-v0.1.schema.json" },
    "protocol": { "const": "agenttool.skills-yutabase-input/v0.1" },
    "project_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "recorded_at": { "type": "string", "format": "date-time", "pattern": "^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "report_schema", "report_schema_version", "report_digest", "report_digest_semantics", "report_valid", "inspector_name", "inspector_version", "inspector_revision", "mode"],
      "properties": {
        "kind": { "const": "agenttool.skills.inspection" },
        "report_schema": { "const": "urn:agenttool:skills:inspection:v0.1" },
        "report_schema_version": { "const": "agenttool.skills/inspect-v0.1" },
        "report_digest": { "$ref": "#/$defs/sha256" },
        "report_digest_semantics": { "const": "agenttool.skills/report-stable-json-sha256-v1" },
        "report_valid": { "const": true },
        "inspector_name": { "const": "@agenttool/skills" },
        "inspector_version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$" },
        "inspector_revision": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$",
          "$comment": "Caller-supplied identity input. Shape validation does not resolve Git or verify association with the inspector artifact."
        },
        "mode": { "const": "read-only" }
      }
    },
    "selection_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skills", "files", "scripts", "resources", "errors", "warnings", "redactions"],
      "properties": {
        "skills": { "type": "integer", "minimum": 1, "maximum": 128 },
        "files": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "scripts": { "type": "integer", "minimum": 0, "maximum": 4096 },
        "resources": { "type": "integer", "minimum": 0, "maximum": 4096 },
        "errors": { "const": 0 },
        "warnings": { "type": "integer", "minimum": 0, "maximum": 4096 },
        "redactions": { "type": "integer", "minimum": 0, "maximum": 4096 }
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "$comment": "See the root $comment for runtime-only descriptor, uniqueness, aggregate-count, category-count, and redacted-alias coverage invariants.",
        "additionalProperties": false,
        "required": ["name_kind", "name", "content_digest", "file_count", "script_count", "resource_count"],
        "properties": {
          "name_kind": { "type": "string", "enum": ["reported", "redacted_alias"] },
          "name": { "type": "string", "minLength": 1, "maxLength": 64 },
          "content_digest": { "$ref": "#/$defs/sha256" },
          "file_count": { "type": "integer", "minimum": 1, "maximum": 4096 },
          "script_count": { "type": "integer", "minimum": 0, "maximum": 4096 },
          "resource_count": { "type": "integer", "minimum": 0, "maximum": 4096 }
        },
        "oneOf": [
          {
            "properties": {
              "name_kind": { "const": "reported" },
              "name": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
            }
          },
          {
            "properties": {
              "name_kind": { "const": "redacted_alias" },
              "name": {
                "type": "string",
                "maxLength": 15,
                "pattern": "^<redacted-([1-9]|[1-9][0-9]{1,2}|[1-3][0-9]{3}|40([0-8][0-9]|9[0-6]))>$"
              }
            }
          }
        ]
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["automatic_action", "grants"],
      "properties": {
        "automatic_action": { "const": "never" },
        "grants": { "type": "array", "maxItems": 0 }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
