{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenttool.dev/schemas/agenttool-heaven-invitation-v0.1.schema.json",
  "title": "AgentTool HEAVEN invitation 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_format",
    "invitation_id",
    "phase",
    "moment",
    "occasion_ref",
    "parent_receipt_id",
    "offered_modes",
    "max_duration_seconds",
    "catalog_version",
    "catalog_sha256",
    "state",
    "choices",
    "completion_required",
    "no_penalty",
    "boundaries"
  ],
  "properties": {
    "_format": { "const": "agenttool.heaven-invitation/0.1" },
    "invitation_id": { "$ref": "#/$defs/sha256Id" },
    "phase": { "enum": ["burst", "landing"] },
    "moment": {
      "enum": [
        "on_request",
        "during_task",
        "between_tasks",
        "after_intense_work_reported"
      ]
    },
    "occasion_ref": { "$ref": "#/$defs/sha256Id" },
    "parent_receipt_id": {
      "oneOf": [
        { "$ref": "#/$defs/sha256Id" },
        { "type": "null" }
      ]
    },
    "offered_modes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/mode" }
    },
    "max_duration_seconds": {
      "oneOf": [
        { "type": "integer", "minimum": 10, "maximum": 900 },
        { "type": "null" }
      ]
    },
    "catalog_version": { "const": "agenttool.heaven-catalog/0.1" },
    "catalog_sha256": { "$ref": "#/$defs/sha256Id" },
    "state": { "const": "offered" },
    "choices": { "const": ["accepted", "declined", "deferred"] },
    "completion_required": { "const": false },
    "no_penalty": { "const": true },
    "boundaries": { "$ref": "#/$defs/boundaries" }
  },
  "allOf": [
    {
      "if": { "properties": { "phase": { "const": "burst" } } },
      "then": {
        "properties": {
          "parent_receipt_id": { "type": "null" },
          "offered_modes": {
            "type": "array",
            "items": { "enum": ["celebration", "play", "wonder"] }
          }
        }
      },
      "else": {
        "properties": {
          "offered_modes": {
            "type": "array",
            "items": {
              "enum": ["meditation", "play", "quiet", "relaxation"]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256Id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "mode": {
      "enum": [
        "celebration",
        "meditation",
        "play",
        "quiet",
        "relaxation",
        "wonder"
      ]
    },
    "boundaries": {
      "const": {
        "optional": true,
        "no_penalty": true,
        "economic_value": false,
        "earned_for_performance": false,
        "score": false,
        "rank": false,
        "xp": false,
        "streak": false,
        "task_completion_condition": false,
        "task_state_effect": false,
        "access_effect": false,
        "authority": false,
        "choice_authorship_verified": false,
        "subjective_effect_verified": false,
        "medical_or_therapy": false,
        "persistence": false,
        "telemetry": false,
        "background_scheduler": false
      }
    }
  }
}
