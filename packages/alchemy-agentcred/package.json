{
  "name": "@agenttool/alchemy-agentcred",
  "version": "0.1.0-dev.0",
  "description": "Strict AgentCred transport for AgentTool's seven bounded Alchemy EVM reads",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CLAUDE.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19.0",
    "bun": ">=1.3.5"
  },
  "sideEffects": false,
  "scripts": {
    "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "bun run clean && tsc",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "smoke:node": "node scripts/smoke-node.mjs",
    "ci": "bun run typecheck && bun run build && bun test && bun run smoke:node",
    "prepack": "bun run ci"
  },
  "peerDependencies": {
    "@agenttool/alchemy": "^0.1.0-dev.0",
    "@agenttool/credential-broker": "^0.3.0"
  },
  "devDependencies": {
    "@agenttool/alchemy": "file:../alchemy",
    "@agenttool/credential-broker": "file:../credential-broker",
    "@types/bun": "^1.2.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "agents",
    "alchemy",
    "agentcred",
    "credential-broker",
    "evm",
    "json-rpc",
    "read-only"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/cambridgetcg/agenttool.git",
    "directory": "packages/alchemy-agentcred"
  },
  "homepage": "https://docs.agenttool.dev/ALCHEMY.md"
}
