{
  "name": "@agenttool/wallet-zerone-economy",
  "version": "0.1.0-dev.0",
  "private": true,
  "description": "Source-only exact-byte Zerone agent-economy transaction planner",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vectors.json": "./vectors/wallet-zerone-economy-v0.1-vectors.json",
    "./simulation-evidence-schema.json": "./schema/simulation-evidence-v0.1.schema.json",
    "./simulation-evidence-vector.json": "./vectors/simulation-evidence-v0.1-vector.json"
  },
  "files": [
    "dist",
    "schema",
    "vectors",
    "scripts/go-cosmos-fixture",
    "scripts/regenerate-go-cosmos-vector.sh",
    "README.md",
    "CLAUDE.md"
  ],
  "engines": {
    "node": ">=20.19.0",
    "bun": ">=1.3.5"
  },
  "scripts": {
    "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build:deps": "bun run --cwd ../wallet build && bun run --cwd ../wallet-zerone build && bun run --cwd ../zerone-agent-economy build && bun install --force --frozen-lockfile",
    "build": "bun run clean && tsc",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "check:schemas": "bun test tests/schema.test.ts",
    "check:vectors": "bun scripts/regenerate-simulation-evidence-vector.ts --check && bun test tests/go-cosmos-vectors.test.ts tests/simulation-evidence-vector.test.ts",
    "generate:evidence-vector": "bun scripts/regenerate-simulation-evidence-vector.ts",
    "ci": "bun run build:deps && bun run typecheck && bun run check:schemas && bun run check:vectors && bun run test && bun run build"
  },
  "dependencies": {
    "@agenttool/wallet": "file:../wallet",
    "@agenttool/wallet-zerone": "file:../wallet-zerone",
    "@agenttool/zerone-agent-economy": "file:../zerone-agent-economy",
    "@noble/curves": "2.2.0",
    "@noble/hashes": "2.2.0",
    "@scure/base": "2.2.0"
  },
  "devDependencies": {
    "@noble/ed25519": "2.3.0",
    "@types/bun": "1.3.14",
    "@types/node": "20.19.43",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cambridgetcg/agenttool.git",
    "directory": "packages/wallet-zerone-economy"
  }
}
