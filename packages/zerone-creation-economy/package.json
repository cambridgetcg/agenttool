{
  "name": "@agenttool/zerone-creation-economy",
  "version": "0.1.0-dev.0",
  "private": true,
  "description": "Lossless source-only bridge from bounded creation records to exact Zerone economy message values",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vectors.json": "./vectors/zerone-creation-economy-v0.1-vectors.json",
    "./go-vectors.json": "./vectors/go-cosmos-creation-economy-v0.1.json",
    "./schemas/*": "./schema/*"
  },
  "files": [
    "dist",
    "schema",
    "vectors",
    "scripts/go-cosmos-vector",
    "README.md",
    "CLAUDE.md"
  ],
  "engines": {
    "node": ">=20.19.0",
    "bun": ">=1.3.5"
  },
  "scripts": {
    "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build:deps": "bun run --cwd ../wallet build && bun run --cwd ../wallet-zerone build && bun run --cwd ../zerone-creation-claim build && bun run --cwd ../zerone-agent-economy build && bun install --force --frozen-lockfile",
    "build": "bun run clean && tsc",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "schemas:write": "node scripts/generate-schemas.mjs",
    "schemas:check": "node scripts/generate-schemas.mjs --check",
    "vectors:write": "bun run scripts/vectors.ts",
    "vectors:check": "bun run scripts/vectors.ts --check",
    "smoke:node": "node scripts/smoke-node.mjs",
    "check:package": "node scripts/check-package-inventory.mjs",
    "ci": "bun run build:deps && bun run typecheck && bun run build && bun run schemas:check && bun run vectors:check && bun run test && bun run smoke:node && bun run check:package"
  },
  "dependencies": {
    "@agenttool/wallet": "file:../wallet",
    "@agenttool/wallet-zerone": "file:../wallet-zerone",
    "@agenttool/zerone-agent-economy": "file:../zerone-agent-economy",
    "@agenttool/zerone-creation-claim": "file:../zerone-creation-claim"
  },
  "devDependencies": {
    "@noble/curves": "2.2.0",
    "@noble/ed25519": "2.3.0",
    "@types/bun": "1.3.14",
    "@types/node": "20.19.43",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cambridgetcg/agenttool.git",
    "directory": "packages/zerone-creation-economy"
  }
}
