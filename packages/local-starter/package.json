  "files": ["dist", "skills", ".codex-plugin", ".claude-plugin", "plugin.json", "README.md", "CHANGELOG.md", "LICENSE", "NOTICE"],
  "publishConfig": { "access": "public" },
  "bundlerBunVersion": "1.3.5",
  "scripts": {
    "build": "bun scripts/build-release.ts",
