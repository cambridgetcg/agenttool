{
  "name": "@agenttool/local-starter",
  "version": "0.1.0-dev.1",
  "description": "Explicit files-only context and handoff starter for agent hosts",
  "author": "AgentTool contributors",
  "homepage": "https://github.com/cambridgetcg/agenttool-local-starter#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/cambridgetcg/agenttool.git",
    "directory": "packages/local-starter"
  },
  "bugs": { "url": "https://github.com/cambridgetcg/agenttool-local-starter/issues" },
  "license": "Apache-2.0",
  "type": "module",
  "engines": { "node": ">=22" },
  "exports": { ".": "./dist/core.mjs" },
  "bin": {
    "agenttool-local-starter": "./dist/cli.mjs",
    "agenttool-local-starter-mcp": "./dist/agenttool-local-starter-mcp.js"
