{
  "name": "@agenttool/zerone-agent-economy",
  "version": "0.1.0-dev.0",
  "private": true,
  "description": "Pure source-only records and unsigned projections for a prefunded Zerone agent economy",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema/*": "./schema/*",
    "./vectors.json": "./vectors/zerone-agent-economy-v0.1-vectors.json"
  },
  "files": [
    "dist",
    "schema",
    "vectors",
    "README.md",
    "CLAUDE.md"
  ],
  "engines": {
    "node": ">=20.19.0",
    "bun": ">=1.3.5"
  },
  "scripts": {
    "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build:deps": "bun run --cwd ../wallet build && bun run --cwd ../wallet-zerone build && bun install --force",
    "build": "bun run clean && tsc",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "check:schemas": "bun test tests/schema.test.ts",
    "check:vectors": "bun scripts/vectors.ts --check && bun test tests/vectors.test.ts tests/go-parity.test.ts",
    "ci": "bun run build:deps && bun run typecheck && bun run check:vectors && bun run test && bun run build"
  },
  "dependencies": {
    "@agenttool/wallet": "file:../wallet",
    "@agenttool/wallet-zerone": "file:../wallet-zerone",
    "@noble/curves": "2.2.0"
  },
  "devDependencies": {
    "@noble/ed25519": "2.3.0",
    "@types/bun": "1.3.14",
    "@types/node": "20.19.43",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cambridgetcg/agenttool.git",
    "directory": "packages/zerone-agent-economy"
  }
}
