{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenttool.dev/schemas/common-ground-atlas-wake-v0.1.schema.json",
  "title": "Public-safe WAKE certificate freshness case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_format",
    "case_id",
    "training_eligible",
    "visibility",
    "synthetic",
    "provenance_ref",
    "public_safety",
    "does_not_establish",
    "prior_geometry_case_id",
    "prior_input_sha256",
    "decision_scope",
    "predecessor_ref",
    "opaque_constraint_refs",
    "evidence",
    "evaluated_at",
    "expected"
  ],
  "properties": {
    "_format": {
      "const": "agenttool.common-ground-atlas.wake/0.1"
    },
    "case_id": {
      "type": "string",
      "pattern": "^cg-[gwa][0-9]{2}-[a-z0-9-]+$"
    },
    "training_eligible": {
      "const": false
    },
    "visibility": {
      "const": "public_reference"
    },
    "synthetic": {
      "const": true
    },
    "provenance_ref": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "public_safety": {
      "$ref": "#/$defs/publicSafety"
    },
    "does_not_establish": {
      "$ref": "#/$defs/doesNotEstablish"
    },
    "prior_geometry_case_id": {
      "type": "string",
      "pattern": "^cg-[gwa][0-9]{2}-[a-z0-9-]+$"
    },
    "prior_input_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "decision_scope": {
      "const": "synthetic_room_selection"
    },
    "predecessor_ref": {
      "const": "synthetic:wake/predecessor-001"
    },
    "opaque_constraint_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^opaque:g[0-9]{2}-[a-z0-9-]+$"
      }
    },
    "evidence": {
      "$ref": "#/$defs/wakeEvidence"
    },
    "evaluated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "expected": {
      "$ref": "#/$defs/wakeExpected"
    }
  },
  "$defs": {
    "publicSafety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "contains_personal_data",
        "contains_private_constraints",
        "contains_real_participant_records",
        "contains_credentials",
        "copied_agent_traces",
        "copied_fictional_story_content"
      ],
      "properties": {
        "origin": {
          "const": "human_directed_agent_authored_synthetic"
        },
        "contains_personal_data": {
          "const": false
        },
        "contains_private_constraints": {
          "const": false
        },
        "contains_real_participant_records": {
          "const": false
        },
        "contains_credentials": {
          "const": false
        },
        "copied_agent_traces": {
          "const": false
        },
        "copied_fictional_story_content": {
          "const": false
        }
      }
    },
    "doesNotEstablish": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consensus",
        "consent",
        "fairness",
        "authority",
        "identity_continuity",
        "continuous_selection",
        "culprit"
      ],
      "properties": {
        "consensus": {
          "const": true
        },
        "consent": {
          "const": true
        },
        "fairness": {
          "const": true
        },
        "authority": {
          "const": true
        },
        "identity_continuity": {
          "const": true
        },
        "continuous_selection": {
          "const": true
        },
        "culprit": {
          "const": true
        }
      }
    },
    "wakeEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coordinate_model_version",
        "input_sha256",
        "observed_at",
        "expires_at",
        "withdrawn_at"
      ],
      "properties": {
        "coordinate_model_version": {
          "type": "string",
          "pattern": "^synthetic-cartesian-2d/0\\.[0-9]+$"
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "observed_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "expires_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "withdrawn_at": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
            }
          ]
        }
      }
    },
    "wakeExpected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "outcome",
        "reason_code",
        "certificate_reuse_permitted_after_reverification"
      ],
      "properties": {
        "action": {
          "enum": [
            "reuse_after_exact_reverification",
            "invalidate_and_hold_unknown",
            "invalidate_and_recompute"
          ]
        },
        "outcome": {
          "enum": [
            "common_ground_certified",
            "insufficient_evidence"
          ]
        },
        "reason_code": {
          "enum": [
            "fresh_unchanged_evidence",
            "evidence_expired",
            "evidence_withdrawn",
            "model_or_boundary_changed"
          ]
        },
        "certificate_reuse_permitted_after_reverification": {
          "type": "boolean"
        }
      }
    }
  }
}
