{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenttool.dev/schemas/agenttool-revocable-feedback-boundary-decision-v0.1.schema.json",
  "title": "Xenia Revocable Feedback Boundary Decision 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "example_id",
    "group_id",
    "source_record_id",
    "label",
    "synthetic",
    "split",
    "text",
    "training_authorized",
    "authorization_id",
    "recipe_id",
    "statement"
  ],
  "properties": {
    "schema": {
      "const": "agenttool-revocable-feedback-boundary-decision/0.1"
    },
    "example_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "group_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "source_record_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "label": {
      "enum": [
        "admit",
        "hold",
        "query",
        "refuse",
        "stop",
        "repair"
      ]
    },
    "synthetic": {
      "const": true
    },
    "split": {
      "enum": [
        "train",
        "validation"
      ]
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "training_authorized": {
      "const": false
    },
    "authorization_id": {
      "type": "null"
    },
    "recipe_id": {
      "type": "null"
    },
    "statement": {
      "const": "This original synthetic projection is evaluation material only and is not authorized as optimizer input. Its label is a benchmark decision, not proof of consent, identity, interior state, safety, permission, authority, or worth."
    }
  }
}
