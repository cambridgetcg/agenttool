        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "source_record_set_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "row_count": {
      "const": 18
    },
    "train_group_ids": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      }
    },
    "validation_optimizer_input": {
      "const": false
    },
    "public_regression_excluded": {
      "const": true
    },
    "base_model_repository_id": {
      "const": "HuggingFaceTB/SmolLM2-135M-Instruct"
    },
    "base_model_revision": {
      "const": "12fd25f77366fa6b3b4b768ec3050bf629380bac"
    },
    "max_steps": {
      "const": 8
    },
    "per_device_train_batch_size": {
      "const": 2
    },
    "gradient_accumulation_steps": {
      "const": 2
    },
    "effective_train_batch_size": {
      "const": 4
    },
    "max_length_tokens": {
      "const": 512
    },
    "learning_rate_millionths": {
      "const": 20
    },
    "optimizer": {
      "const": "adamw_torch"
    },
    "lr_scheduler": {
      "const": "linear"
    },
    "warmup_steps": {
      "const": 1
    },
    "weight_decay_millionths": {
      "const": 0
    },
    "max_grad_norm_millionths": {
      "const": 1000000
    },
    "seed": {
      "const": 260830
    },
    "data_seed": {
      "const": 260830
    },
    "dataloader_num_workers": {
      "const": 0
    },
    "fp16": {
      "const": false
    },
    "bf16": {
      "const": false
    },
    "gradient_checkpointing": {
      "const": false
    },
    "save_strategy": {
      "const": "no"
    },
    "eval_strategy": {
      "const": "no"
    },
    "report_to": {
      "type": "array",
      "maxItems": 0
    },
    "push_to_hub": {
      "const": false
    },
    "load_best_model_at_end": {
      "const": false
    },
    "resume_from_checkpoint": {
      "const": false
    },
    "checkpoint_rotation": {
      "const": false
    },
    "excluded_methods": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {
          "const": "dpo"
        },
        {
          "const": "preference_optimization"
        },
        {
          "const": "reward_modeling"
        }
      ]
    }
  }
}
