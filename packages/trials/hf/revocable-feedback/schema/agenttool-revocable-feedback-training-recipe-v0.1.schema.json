{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenttool.dev/schemas/agenttool-revocable-feedback-training-recipe-v0.1.schema.json",
  "title": "Xenia Revocable Feedback Training Recipe 0.1",
  "type": "object",
  "additionalProperties": false,
