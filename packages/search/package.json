{
  "name": "@agenttool/search",
  "version": "0.1.0-dev.0",
  "private": true,
  "description": "Local agent search evidence router with explicit browser handoff",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./schema.json": {
      "default": "./schema/agenttool-search-v0.1.schema.json"
    },
    "./inspection-schema.json": {
      "default": "./schema/agenttool-search-inspection-v0.1.schema.json"
    }
  },
  "bin": {
    "agenttool-search": "dist/bin/agenttool-search.js"
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "CLAUDE.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "engines": {
    "node": ">=20.19.0",
    "bun": ">=1.3.5"
  },
  "scripts": {
    "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "bun run clean && tsc",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "smoke:runtimes": "node --input-type=module --eval \"const m = await import('./dist/src/index.js'); if (m.SEARCH_SCHEMA !== 'agenttool-search/v0.1' || typeof m.SearchEngine !== 'function') process.exit(1)\" && bun --eval \"const m = await import('./dist/src/index.js'); if (m.SEARCH_SCHEMA !== 'agenttool-search/v0.1' || typeof m.SearchEngine !== 'function') process.exit(1)\"",
    "check:package": "npm pack --dry-run --ignore-scripts",
    "ci": "bun run typecheck && bun run test && bun run build && bun run smoke:runtimes && bun run check:package",
    "prepack": "bun run typecheck && bun run test && bun run build"
  },
  "peerDependencies": {
    "@agenttool/browser": "^0.3.0",
    "@agenttool/telescope": "^0.2.3"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0-beta.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@agenttool/browser": "file:../../apps/docs/packages/v1/@agenttool/browser/0.3.0/agenttool-browser-0.3.0.tgz",
    "@agenttool/telescope": "file:../../apps/docs/packages/v1/@agenttool/telescope/0.2.3/agenttool-telescope-0.2.3.tgz",
    "@types/bun": "^1.2.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "agents",
    "browser",
    "search",
    "evidence",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/cambridgetcg/agenttool.git",
    "directory": "packages/search"
  },
  "homepage": "https://github.com/cambridgetcg/agenttool/tree/main/packages/search#readme"
}
