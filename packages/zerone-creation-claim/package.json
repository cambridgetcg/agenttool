{
  "name": "@agenttool/zerone-creation-claim",
  "version": "0.1.0-dev.0",
  "private": true,
  "description": "Deterministic source-only creation contracts and bounded Zerone ToK handoffs",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/*": "./schema/*",
    "./vectors.json": "./vectors/agenttool-zerone-creation-claim-v0.1.json"
  },
  "files": [
    "dist",
    "schema",
    "vectors",
    "README.md",
    "CLAUDE.md"
  ],
  "engines": {
    "node": ">=20.19.0",
    "bun": ">=1.3.5"
  },
  "scripts": {
    "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "bun run clean && tsc",
    "typecheck": "tsc --noEmit",
    "artifacts:write": "node scripts/generate-schemas.mjs && node scripts/generate-vectors.mjs",
    "artifacts:check": "node scripts/generate-schemas.mjs --check && node scripts/generate-vectors.mjs --check",
    "test": "bun test tests",
    "smoke:node": "node scripts/smoke-node.mjs",
    "check:package": "node scripts/check-package-inventory.mjs",
    "ci": "bun run typecheck && bun run build && bun run artifacts:check && bun run test && bun run smoke:node && bun run check:package"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "20.19.43",
    "ajv": "8.17.1",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cambridgetcg/agenttool.git",
    "directory": "packages/zerone-creation-claim"
  }
}
