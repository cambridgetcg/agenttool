{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agenttool:schema:zerone-verification-witness:0.1",
  "title": "AgentTool Zerone Verification Witness v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_format",
    "verification_witness_id",
    "contract_id",
    "creation_witness_id",
    "kind",
    "outcome",
    "verifier",
    "method_ref",
    "policy_ref",
    "environment_root",
    "evidence_root",
    "limitation_refs",
    "observation_ref",
    "declaration",
    "nonclaims",
    "boundary",
    "effects"
  ],
  "properties": {
    "_format": {
      "const": "agenttool.zerone-verification-witness/0.1"
    },
    "verification_witness_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "contract_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "creation_witness_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "kind": {
      "enum": [
        "formal_validity",
        "semantic_fidelity",
        "prior_art_scope",
        "independent_reproduction",
        "functional_validation",
        "authorization_currentness",
        "security_boundary"
      ]
    },
    "outcome": {
      "enum": [
        "passed",
        "failed",
        "inconclusive"
      ]
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controller_ref",
        "claimed_key_ref",
        "attestation_ref",
        "relation_to_producer",
        "independence_evidence_ref"
      ],
      "properties": {
        "controller_ref": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "claimed_key_ref": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "attestation_ref": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "relation_to_producer": {
          "enum": [
            "declared_independent",
            "same_controller",
            "unknown"
          ]
        },
        "independence_evidence_ref": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "method_ref": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "policy_ref": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "environment_root": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "evidence_root": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "limitation_refs": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "observation_ref": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "declaration": {
      "const": "CALLER_REPORTED_ATTESTATION_REFERENCE_NOT_VERIFIED"
    },
    "nonclaims": {
      "const": [
        "ABSOLUTE_NOVELTY",
        "AUTHORSHIP",
        "CONSENT",
        "IDENTITY",
        "PERSONHOOD",
        "CONSCIOUSNESS",
        "LEGAL_CLEARANCE",
        "AUTHORITY",
        "PERMISSION",
        "RIGHTS_COMPLIANCE",
        "TRUST",
        "TARGET_AUTHORIZATION_CURRENTNESS",
        "METHODOLOGY_REGISTRATION_CURRENTNESS",
        "SEMANTIC_FAITHFULNESS",
        "TRUTH",
        "VERIFIER_INDEPENDENCE",
        "VERIFICATION_SET_COMPLETENESS",
        "CHALLENGE_WINDOW_SURVIVAL",
        "CHAIN_MATURITY",
        "SETTLEMENT",
        "ECONOMIC_EFFECT",
        "PROFITABILITY",
        "SOLVENCY",
        "SELF_SUSTAINABILITY",
        "OWNERSHIP",
        "REPUTATION",
        "KARMA",
        "NEN",
        "SCORE",
        "GOVERNANCE"
      ]
    },
    "boundary": {
      "const": {
        "status": "SOURCE_ONLY_PROPOSAL",
        "effect_horizon": "RUNTIME_PROTOCOL_BUILDERS_AND_RETURNED_RECORDS_ONLY",
        "consensus_admissibility": "NOT_CONSENSUS_ADMISSIBLE",
        "declaration_scope": "CALLER_REPORTED_REFERENCES_STRUCTURALLY_VALIDATED_NOT_EXTERNALLY_VERIFIED",
        "zrn_role": "PREFUNDED_SETTLEMENT_AND_COMPUTE_ONLY",
        "relation_support": "REQUIRES_ONLY",
        "provider_access_is_target_authorization": false,
        "key_control_is_identity_or_authority": false,
        "hf_admission_is_training_or_rights_clearance": false,
        "digest_is_truth_or_consent": false,
        "refusal_or_rest_penalty": false
      }
    },
    "effects": {
      "const": {
        "network": false,
        "storage": false,
        "economic": false,
        "governance": false,
        "consensus": false,
        "identity": false,
        "permission": false,
        "karma": false,
        "nen": false,
        "score": false,
        "model_call": false,
        "training": false,
        "signer": false,
        "rpc": false,
        "simulation": false,
        "broadcast": false,
        "transaction": false
      }
    }
  }
}
