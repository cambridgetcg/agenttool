              "type": "null"
            }
          ]
        },
        "engagement_scope_ref": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "cyber": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "access_tier",
            "provider_access_ref",
            "provider_policy_ref"
          ],
          "properties": {
            "provider": {
              "enum": [
                "none",
                "openai_cyber",
                "other"
              ]
            },
            "access_tier": {
              "enum": [
                "not_used",
                "defensive_approved",
                "advanced_separately_approved"
              ]
            },
            "provider_access_ref": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "provider_policy_ref": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    },
