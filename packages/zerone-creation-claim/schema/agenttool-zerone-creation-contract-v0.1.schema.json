      "properties": {
        "model_ref": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "toolchain_ref": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "environment_root": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "isolation_policy_ref": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "disclosure_policy_ref": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "outcome_routes": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "outcome",
          "tok_posture",
          "settlement_posture",
          "requirements"
        ],
        "properties": {
          "outcome": {
            "enum": [
              "bounded_answer",
              "no_bounded_answer",
              "ambiguity_or_non_identifiability",
              "method_or_assumption_failure",
              "resource_or_participation_stop"
            ]
          },
          "tok_posture": {
            "enum": [
              "digest_fact_candidate",
              "offchain_only"
            ]
          },
          "settlement_posture": {
            "enum": [
              "not_requested",
              "separate_activation_required"
            ]
          },
          "requirements": {
            "type": "array",
            "minItems": 0,
            "maxItems": 7,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "minimum_passes",
                "independence",
                "policy_ref"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "formal_validity",
                    "semantic_fidelity",
                    "prior_art_scope",
                    "independent_reproduction",
                    "functional_validation",
                    "authorization_currentness",
                    "security_boundary"
                  ]
                },
                "minimum_passes": {
                  "type": "string",
                  "pattern": "^(?:[1-9][0-9]{0,0}|1[0-5][0-9]{0}|16)$",
                  "maxLength": 2
                },
                "independence": {
                  "enum": [
                    "distinct_from_producer_required",
                    "not_required"
                  ]
                },
                "policy_ref": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              }
            }
          }
        }
      }
    },
