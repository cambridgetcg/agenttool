{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agenttool:schema:zerone-creation-contract:0.1",
  "title": "AgentTool Zerone Creation Contract v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_format",
    "contract_id",
    "lane",
    "artifact_kind",
    "claim_policy",
    "math_card",
    "target",
    "hf_run",
    "authorities",
    "execution",
    "outcome_routes",
    "input_root",
    "acceptance_hash",
    "source_plane",
    "nonclaims",
    "boundary",
    "effects"
  ],
  "properties": {
    "_format": {
      "const": "agenttool.zerone-creation-contract/0.1"
    },
    "contract_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "lane": {
      "enum": [
        "formal_math",
        "defensive_security"
      ]
    },
    "artifact_kind": {
      "enum": [
        "algorithm",
        "bounded_process_result",
        "counterexample",
        "defensive_patch",
        "detector",
        "formal_result",
        "security_invariant"
      ]
    },
    "claim_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "method_id",
        "methodology_registry_evidence_ref",
        "methodology_observation_status",
        "max_review_stake_uzrn"
      ],
      "properties": {
        "category": {
          "enum": [
            "computational",
            "formal"
          ]
        },
        "method_id": {
          "enum": [
            "M-FORMAL",
            "M-COMPUTATIONAL"
          ]
        },
        "methodology_registry_evidence_ref": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "methodology_observation_status": {
          "const": "caller_declared_not_verified"
        },
        "max_review_stake_uzrn": {
          "type": "string",
          "pattern": "^(?:[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4][0-9]{0}|18446744073709551615)$",
          "maxLength": 20
        }
      }
    },
    "math_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "card_id",
        "assessment_id",
        "assessment_status",
        "validation_ref"
      ],
      "properties": {
        "card_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "assessment_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "assessment_status": {
          "const": "ready_for_bounded_inquiry"
        },
        "validation_ref": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_ref",
        "baseline_ref",
        "status_evidence_ref",
        "prior_art_scope_ref",
        "prior_art_cutoff_ref"
      ],
      "properties": {
        "object_ref": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "baseline_ref": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "status_evidence_ref": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "prior_art_scope_ref": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "prior_art_cutoff_ref": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
