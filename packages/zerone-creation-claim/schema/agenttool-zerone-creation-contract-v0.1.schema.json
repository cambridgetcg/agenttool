        "dataset_sources",
        "training_input_roots",
        "split_manifest_ref",
        "role_manifest_ref",
        "transform_manifest_ref",
        "tokenizer_ref",
        "presentation_multiplicity_ref",
        "mixture_weights_ref",
        "order_ref",
        "optimizer_ref",
        "seed_policy_ref",
        "checkpoint_ref"
