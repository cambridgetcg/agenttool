{
  "name": "@agenttool/research-commons",
  "version": "0.1.0-dev.0",
  "private": true,
  "description": "Offline, zero-effect research-funding simulation reference for public-safe theoretical work",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./settlement-bundle.schema.json": "./schema/research-settlement-bundle-v0.1.schema.json",
    "./public-projection.schema.json": "./schema/research-public-projection-v0.1.schema.json",
    "./simulation.schema.json": "./schema/research-simulation-v0.1.schema.json"
  },
  "bin": {
    "agenttool-research-commons": "./dist/bin.js"
  },
  "files": [
    "dist",
    "schema",
    "examples/amplitude-bootstrap-garden",
    "interop",
    "README.md",
    "CLAUDE.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "bun": ">=1.3.5",
    "node": ">=20.19.0"
  },
  "scripts": {
    "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "bun run clean && tsc && chmod 755 dist/bin.js",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "smoke:built-cli": "node tests/built-cli.smoke.mjs",
    "ci": "bun run typecheck && bun run test && bun run build && bun run smoke:built-cli"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "ajv": "8.17.1",
    "typescript": "5.9.3"
  }
}
