{
  "name": "@agenttool/economic-kernel",
  "version": "0.1.0-dev.0",
  "private": true,
  "description": "Pure typed economic transitions, exact price conversion, conserved ledgers, and non-purchasable hard gates",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CLAUDE.md"
  ],
  "engines": {
    "node": ">=20.19.0",
    "bun": ">=1.3.5"
  },
  "scripts": {
    "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "bun run clean && tsc",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "smoke:runtimes": "node tests/built-node.smoke.mjs && bun tests/built-node.smoke.mjs",
    "check:package": "node scripts/check-package-inventory.mjs",
    "smoke:pack": "node scripts/smoke-packed.mjs",
    "ci": "bun run typecheck && bun run test && bun run build && bun run smoke:runtimes && bun run check:package && bun run smoke:pack",
    "prepack": "bun run ci"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "20.19.43",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cambridgetcg/agenttool.git",
    "directory": "packages/economic-kernel"
  }
}
