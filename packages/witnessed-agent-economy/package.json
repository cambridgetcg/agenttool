{
  "name": "@agenttool/witnessed-agent-economy",
  "version": "0.1.0-dev.0",
  "private": true,
  "description": "Pure offline AgentTool projections for the KINGDOM witnessed-agent-economy shadow contract",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/*": "./schema/*",
    "./vectors.json": "./vectors/core-v0.1/known-answer.json"
  },
  "files": [
    "dist",
    "schema",
    "vectors",
    "README.md",
    "CLAUDE.md"
  ],
  "engines": {
    "node": ">=20.19.0",
    "bun": ">=1.3.5"
  },
  "scripts": {
    "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "bun run clean && tsc",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "generate:schemas": "bun scripts/generate-schemas.ts",
    "check:schemas": "bun scripts/generate-schemas.ts --check",
    "import:core-vectors": "node scripts/import-core-corpus.mjs",
    "check:vectors": "bun scripts/check-core-corpus.ts",
    "ci": "bun run check:schemas && bun run typecheck && bun run test && bun run build && bun run check:vectors"
  },
  "dependencies": {
    "@agenttool/public-surface-binding": "file:../public-surface-binding",
    "@agenttool/public-surface-recognition": "file:../public-surface-recognition",
    "@agenttool/wallet": "file:../wallet",
    "@noble/ed25519": "2.3.0",
    "@noble/hashes": "2.0.1",
    "ajv": "8.17.1"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "20.19.43",
    "ajv-formats": "3.0.1",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cambridgetcg/agenttool.git",
    "directory": "packages/witnessed-agent-economy"
  }
}
