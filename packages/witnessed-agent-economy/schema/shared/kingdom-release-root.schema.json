{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kingdom:witnessed-agent-economy:0.1:payload:kingdom-release-root",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "release_ref",
    "ledger_protocol",
    "ledger_document_digest",
    "entry_merkle_root",
    "entry_count",
    "git_commit",
    "git_tree",
    "build_manifest_digest",
    "deployment_manifest_digest",
    "verifier_protocol",
    "verifier_digest",
    "previous_release"
  ],
  "properties": {
    "release_ref": {
      "$ref": "#/$defs/ref"
    },
    "ledger_protocol": {
      "$ref": "#/$defs/protocol"
    },
    "ledger_document_digest": {
      "$ref": "#/$defs/digest"
    },
    "entry_merkle_root": {
      "$ref": "#/$defs/digest"
    },
    "entry_count": {
      "$ref": "#/$defs/uint"
    },
    "git_commit": {
      "$ref": "#/$defs/git"
    },
    "git_tree": {
      "$ref": "#/$defs/git"
    },
    "build_manifest_digest": {
      "$ref": "#/$defs/digest"
    },
    "deployment_manifest_digest": {
      "$ref": "#/$defs/digest"
    },
    "verifier_protocol": {
      "$ref": "#/$defs/protocol"
    },
    "verifier_digest": {
      "$ref": "#/$defs/digest"
    },
    "previous_release": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/digest"
        }
      ]
    }
  },
  "$defs": {
    "ref": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "uint": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "not": {
        "pattern": "^([2-9][0-9]{19}|19[0-9]{18}|18[5-9][0-9]{17}|184[5-9][0-9]{16}|1844[7-9][0-9]{15}|18446[8-9][0-9]{14}|184467[5-9][0-9]{13}|1844674[5-9][0-9]{12}|18446744[1-9][0-9]{11}|184467440[8-9][0-9]{10}|1844674407[4-9][0-9]{9}|18446744073[8-9][0-9]{8}|184467440737[1-9][0-9]{7}|18446744073709[6-9][0-9]{5}|184467440737095[6-9][0-9]{4}|1844674407370955[2-9][0-9]{3}|18446744073709551[7-9][0-9]{2}|184467440737095516[2-9][0-9]|1844674407370955161[6-9])$"
      }
    },
    "protocol": {
      "type": "string",
      "pattern": "^(?!.*//)[a-z][a-z0-9.-]{0,63}/[A-Za-z0-9._/-]{1,127}$"
    },
    "git": {
      "type": "string",
      "pattern": "^(sha1:[0-9a-f]{40}|sha256:[0-9a-f]{64})$"
    }
  }
}
