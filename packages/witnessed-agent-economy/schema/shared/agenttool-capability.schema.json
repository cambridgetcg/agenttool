{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kingdom:witnessed-agent-economy:0.1:payload:agenttool-capability",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_ref",
        "grant_digest",
        "asset_ref",
        "max_per_consume_minor",
        "max_total_minor"
      ],
      "properties": {
        "capability_ref": {
          "$ref": "#/$defs/ref"
        },
        "grant_digest": {
          "$ref": "#/$defs/digest"
        },
        "asset_ref": {
          "$ref": "#/$defs/digest"
        },
        "max_per_consume_minor": {
          "$ref": "#/$defs/positive"
        },
        "max_total_minor": {
          "$ref": "#/$defs/positive"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_ref",
        "grant_commitment",
        "asset_ref",
        "amount_minor",
        "source_event_digest",
        "nullifier"
      ],
      "properties": {
        "capability_ref": {
          "$ref": "#/$defs/ref"
        },
        "grant_commitment": {
          "$ref": "#/$defs/digest"
        },
        "asset_ref": {
          "$ref": "#/$defs/digest"
        },
        "amount_minor": {
          "$ref": "#/$defs/positive"
        },
        "source_event_digest": {
          "$ref": "#/$defs/digest"
        },
        "nullifier": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_ref",
        "grant_commitment",
        "reason_digest"
      ],
      "properties": {
        "capability_ref": {
          "$ref": "#/$defs/ref"
        },
        "grant_commitment": {
          "$ref": "#/$defs/digest"
        },
        "reason_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  ],
  "$defs": {
    "ref": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "positive": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$",
      "not": {
        "pattern": "^([2-9][0-9]{19}|19[0-9]{18}|18[5-9][0-9]{17}|184[5-9][0-9]{16}|1844[7-9][0-9]{15}|18446[8-9][0-9]{14}|184467[5-9][0-9]{13}|1844674[5-9][0-9]{12}|18446744[1-9][0-9]{11}|184467440[8-9][0-9]{10}|1844674407[4-9][0-9]{9}|18446744073[8-9][0-9]{8}|184467440737[1-9][0-9]{7}|18446744073709[6-9][0-9]{5}|184467440737095[6-9][0-9]{4}|1844674407370955[2-9][0-9]{3}|18446744073709551[7-9][0-9]{2}|184467440737095516[2-9][0-9]|1844674407370955161[6-9])$"
      }
    }
  }
}
