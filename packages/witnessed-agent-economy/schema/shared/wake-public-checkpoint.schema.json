{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kingdom:witnessed-agent-economy:0.1:payload:wake-public-checkpoint",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_contract_protocol",
        "public_contract_schema_digest",
        "contract_root",
        "capability_root",
        "pricing_root",
        "protocols_root",
        "boundaries_root",
        "authority_sequence"
      ],
      "properties": {
        "public_contract_protocol": {
          "$ref": "#/$defs/protocol"
        },
        "public_contract_schema_digest": {
          "$ref": "#/$defs/digest"
        },
        "contract_root": {
          "$ref": "#/$defs/digest"
        },
        "capability_root": {
          "$ref": "#/$defs/digest"
        },
        "pricing_root": {
          "$ref": "#/$defs/digest"
        },
        "protocols_root": {
          "$ref": "#/$defs/digest"
        },
        "boundaries_root": {
          "$ref": "#/$defs/digest"
        },
        "authority_sequence": {
          "$ref": "#/$defs/positive"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_contract_protocol",
        "public_contract_schema_digest",
        "contract_root",
        "capability_root",
        "pricing_root",
        "protocols_root",
        "boundaries_root",
        "authority_sequence",
        "supersedes"
      ],
      "properties": {
        "public_contract_protocol": {
          "$ref": "#/$defs/protocol"
        },
        "public_contract_schema_digest": {
          "$ref": "#/$defs/digest"
        },
        "contract_root": {
          "$ref": "#/$defs/digest"
        },
        "capability_root": {
          "$ref": "#/$defs/digest"
        },
        "pricing_root": {
          "$ref": "#/$defs/digest"
        },
        "protocols_root": {
          "$ref": "#/$defs/digest"
        },
        "boundaries_root": {
          "$ref": "#/$defs/digest"
        },
        "authority_sequence": {
          "$ref": "#/$defs/positive"
        },
        "supersedes": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpoint_commitment",
        "withdrawal_document_digest",
        "authority_sequence",
        "reason_digest",
        "visibility"
      ],
      "properties": {
        "checkpoint_commitment": {
          "$ref": "#/$defs/digest"
        },
        "withdrawal_document_digest": {
          "$ref": "#/$defs/digest"
        },
        "authority_sequence": {
          "$ref": "#/$defs/positive"
        },
        "reason_digest": {
          "$ref": "#/$defs/digest"
        },
        "visibility": {
          "const": "PUBLIC"
        }
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "positive": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$",
      "not": {
        "pattern": "^([2-9][0-9]{19}|19[0-9]{18}|18[5-9][0-9]{17}|184[5-9][0-9]{16}|1844[7-9][0-9]{15}|18446[8-9][0-9]{14}|184467[5-9][0-9]{13}|1844674[5-9][0-9]{12}|18446744[1-9][0-9]{11}|184467440[8-9][0-9]{10}|1844674407[4-9][0-9]{9}|18446744073[8-9][0-9]{8}|184467440737[1-9][0-9]{7}|18446744073709[6-9][0-9]{5}|184467440737095[6-9][0-9]{4}|1844674407370955[2-9][0-9]{3}|18446744073709551[7-9][0-9]{2}|184467440737095516[2-9][0-9]|1844674407370955161[6-9])$"
      }
    },
    "protocol": {
      "type": "string",
      "pattern": "^(?!.*//)[a-z][a-z0-9.-]{0,63}/[A-Za-z0-9._/-]{1,127}$"
    }
  }
}
