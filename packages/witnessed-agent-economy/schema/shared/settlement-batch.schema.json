{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kingdom:witnessed-agent-economy:0.1:settlement-batch-sidecar",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "first_sequence",
    "last_sequence",
    "receipt_count",
    "declared_gaps",
    "leaves"
  ],
  "properties": {
    "first_sequence": {
      "$ref": "#/$defs/positive"
    },
    "last_sequence": {
      "$ref": "#/$defs/positive"
    },
    "receipt_count": {
      "$ref": "#/$defs/positive"
    },
    "declared_gaps": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "first",
          "last"
        ],
        "properties": {
          "first": {
            "$ref": "#/$defs/positive"
          },
          "last": {
            "$ref": "#/$defs/positive"
          }
        }
      }
    },
    "leaves": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "receipt_digest"
        ],
        "properties": {
          "sequence": {
            "$ref": "#/$defs/positive"
          },
          "receipt_digest": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "positive": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$",
      "not": {
        "pattern": "^([2-9][0-9]{19}|19[0-9]{18}|18[5-9][0-9]{17}|184[5-9][0-9]{16}|1844[7-9][0-9]{15}|18446[8-9][0-9]{14}|184467[5-9][0-9]{13}|1844674[5-9][0-9]{12}|18446744[1-9][0-9]{11}|184467440[8-9][0-9]{10}|1844674407[4-9][0-9]{9}|18446744073[8-9][0-9]{8}|184467440737[1-9][0-9]{7}|18446744073709[6-9][0-9]{5}|184467440737095[6-9][0-9]{4}|1844674407370955[2-9][0-9]{3}|18446744073709551[7-9][0-9]{2}|184467440737095516[2-9][0-9]|1844674407370955161[6-9])$"
      }
    }
  }
}
