{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kingdom:witnessed-agent-economy:0.1:payload:dispute-terminal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "settlement_commitment",
    "outcome",
    "decision_digest",
    "distribution_root"
  ],
  "properties": {
    "settlement_commitment": {
      "$ref": "#/$defs/digest"
    },
    "outcome": {
      "enum": [
        "RELEASE",
        "REFUND",
        "SPLIT",
        "DISMISS"
      ]
    },
    "decision_digest": {
      "$ref": "#/$defs/digest"
    },
    "distribution_root": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
