{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenttool.dev/schemas/public-wake-contract/0.1.json",
  "title": "AgentTool root-signed public WAKE contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "audience",
    "subject_ref",
    "controller_ref",
    "authority_sequence",
    "previous_contract_id",
    "roots",
    "valid_from",
    "expires_at",
    "nonce",
    "authority",
    "boundaries",
    "signature",
    "contract_id"
  ],
  "properties": {
    "schema": {
      "const": "agenttool.public-wake-contract/0.1"
    },
    "audience": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{0,31}:[a-z0-9][a-z0-9._-]{0,95}$"
    },
    "subject_ref": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "controller_ref": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authority_sequence": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$",
      "not": {
        "pattern": "^([2-9][0-9]{19}|19[0-9]{18}|18[5-9][0-9]{17}|184[5-9][0-9]{16}|1844[7-9][0-9]{15}|18446[8-9][0-9]{14}|184467[5-9][0-9]{13}|1844674[5-9][0-9]{12}|18446744[1-9][0-9]{11}|184467440[8-9][0-9]{10}|1844674407[4-9][0-9]{9}|18446744073[8-9][0-9]{8}|184467440737[1-9][0-9]{7}|18446744073709[6-9][0-9]{5}|184467440737095[6-9][0-9]{4}|1844674407370955[2-9][0-9]{3}|18446744073709551[7-9][0-9]{2}|184467440737095516[2-9][0-9]|1844674407370955161[6-9])$"
      }
    },
    "previous_contract_id": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      ]
    },
    "roots": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilities",
        "prices",
        "protocols",
        "safety"
      ],
      "properties": {
        "capabilities": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "prices": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "protocols": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "safety": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "valid_from": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "nonce": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scheme",
        "public_key",
        "key_fingerprint",
        "registry_match",
        "multi_root_quorum"
      ],
      "properties": {
        "scheme": {
          "const": "single_ed25519"
        },
        "public_key": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "key_fingerprint": {
          "type": "string",
          "pattern": "^ed25519-sha256:[0-9a-f]{64}$"
        },
        "registry_match": {
          "const": "not_established"
        },
        "multi_root_quorum": {
          "const": "not_implemented"
        }
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "current_v1_wake_used",
        "private_wake_included",
        "capabilities_disclosed",
        "prices_disclosed",
        "protocols_disclosed",
        "safety_disclosed",
        "key_control",
        "identity",
        "personhood",
        "consciousness",
        "consent",
        "competence",
        "truth",
        "quality",
        "reputation",
        "authority_effect",
        "economic_effect",
        "wake_effect",
        "memory_effect",
        "score_effect",
        "automatic_action"
      ],
      "properties": {
        "source": {
          "const": "explicit_root_signed_public_contract"
        },
        "current_v1_wake_used": {
          "const": false
        },
        "private_wake_included": {
          "const": false
        },
        "capabilities_disclosed": {
          "const": "roots_only"
        },
        "prices_disclosed": {
          "const": "roots_only"
        },
        "protocols_disclosed": {
          "const": "roots_only"
        },
        "safety_disclosed": {
          "const": "roots_only"
        },
        "key_control": {
          "const": "signature_only"
        },
        "identity": {
          "const": "not_established"
        },
        "personhood": {
          "const": "not_established"
        },
        "consciousness": {
          "const": "not_established"
        },
        "consent": {
          "const": "not_established"
        },
        "competence": {
          "const": "not_established"
        },
        "truth": {
          "const": "not_established"
        },
        "quality": {
          "const": "not_scored"
        },
        "reputation": {
          "const": "not_scored"
        },
        "authority_effect": {
          "const": "NONE"
        },
        "economic_effect": {
          "const": "NONE"
        },
        "wake_effect": {
          "const": false
        },
        "memory_effect": {
          "const": false
        },
        "score_effect": {
          "const": false
        },
        "automatic_action": {
          "const": false
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "public_key",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "public_key": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{128}$"
        }
      }
    },
    "contract_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
