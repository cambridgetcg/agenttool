{
  "name": "@agenttool/codex-usage",
  "version": "0.1.0",
  "description": "Privacy-minimal live local Codex token usage inspection for agents and operators",
  "author": "AgentTool contributors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/cambridgetcg/agenttool.git",
    "directory": "packages/codex-usage"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./mcp": {
      "types": "./dist/src/mcp.d.ts",
      "import": "./dist/src/mcp.js"
    }
  },
  "bin": {
    "agenttool-codex-usage": "./dist/bin/agenttool-codex-usage.js"
  },
  "files": [
    "dist",
    "README.md",
    "CLAUDE.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "bun": ">=1.3.5"
  },
  "scripts": {
    "clean": "bun --eval 'import { rmSync } from \"node:fs\"; rmSync(\"dist\", { recursive: true, force: true })'",
    "build": "bun run clean && tsc",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "smoke": "bun dist/bin/agenttool-codex-usage.js --help >/dev/null",
    "ci": "bun run typecheck && bun run test && bun run build && bun run smoke",
    "prepack": "bun run ci"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0-beta.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "agents",
    "codex",
    "local-first",
    "mcp",
    "token-usage"
  ]
}
