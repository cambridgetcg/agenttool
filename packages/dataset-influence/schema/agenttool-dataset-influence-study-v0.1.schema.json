                "properties": {
                  "numerator": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "denominator": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "interval": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "lower",
                  "upper",
                  "level_basis_points",
                  "method_ref"
                ],
                "properties": {
                  "lower": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "numerator",
                      "denominator"
                    ],
                    "properties": {
                      "numerator": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      "denominator": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      }
                    }
                  },
                  "upper": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "numerator",
                      "denominator"
                    ],
                    "properties": {
                      "numerator": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      "denominator": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      }
                    }
                  },
                  "level_basis_points": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9999
                  },
                  "method_ref": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "unit_ref": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "claim_scope": {
            "enum": [
              "observed_association",
              "design_bound_contrast",
              "causal_under_declared_assumptions",
              "unavailable"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "assumption_refs": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "limitation_refs": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "minItems": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "claim_scope": {
                  "const": "unavailable"
                }
              },
              "required": [
                "claim_scope"
              ]
            },
            "then": {
              "properties": {
                "estimate": {
                  "type": "null"
                },
                "interval": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "estimate": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "numerator",
                    "denominator"
                  ],
                  "properties": {
                    "numerator": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "denominator": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    }
                  }
                },
                "evidence_refs": {
                  "type": "array",
                  "maxItems": 64,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "minItems": 1
                },
                "assumption_refs": {
                  "type": "array",
                  "maxItems": 64,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "claim_scope": {
                  "const": "causal_under_declared_assumptions"
