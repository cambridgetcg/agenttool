        }
      }
    },
    {
      "if": {
        "properties": {
          "design": {
            "const": "paired_ablation"
          }
        },
        "required": [
          "design"
        ]
      },
      "then": {
        "properties": {
          "estimator": {
            "enum": [
              "paired_difference"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "design": {
            "const": "randomized_dataset_inclusion"
          }
        },
        "required": [
          "design"
        ]
      },
      "then": {
        "properties": {
          "estimator": {
            "enum": [
              "difference_in_means",
              "paired_difference"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "design": {
            "const": "matched_reweighting"
          }
        },
        "required": [
          "design"
        ]
      },
      "then": {
        "properties": {
          "estimator": {
            "enum": [
              "difference_in_means",
              "paired_difference"
            ]
          }
        }
