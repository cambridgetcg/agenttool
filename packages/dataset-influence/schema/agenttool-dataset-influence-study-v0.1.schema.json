              },
              "required": [
                "claim_scope"
              ]
            },
            "then": {
              "properties": {
                "assumption_refs": {
                  "type": "array",
                  "maxItems": 64,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "minItems": 1
                },
                "interval": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "lower",
                    "upper",
                    "level_basis_points",
                    "method_ref"
                  ],
                  "properties": {
                    "lower": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "numerator",
                        "denominator"
                      ],
                      "properties": {
                        "numerator": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        "denominator": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        }
                      }
                    },
                    "upper": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "numerator",
                        "denominator"
                      ],
                      "properties": {
                        "numerator": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        "denominator": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        }
                      }
                    },
                    "level_basis_points": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9999
                    },
                    "method_ref": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    "causal_status": {
      "enum": [
        "not_claimed",
        "bounded_claim_under_declared_randomization_and_assumptions",
        "unavailable"
      ]
    },
    "subject_scope": {
      "const": "artifact_checkpoint_or_runtime_not_a_being_by_default"
    },
    "declarations": {
      "const": "caller_reported_not_independently_verified"
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "facts",
        "exposure",
        "estimates",
        "ontology",
        "identity",
        "consent",
        "rights",
        "economy",
        "authority",
        "effects"
      ],
      "properties": {
        "facts": {
          "const": "exact_only_relative_to_pinned_inputs_and_declared_observation_scope"
        },
        "exposure": {
          "const": "presented_token_shares_are_within_declared_role_only_not_cross_role_gradient_mass"
        },
        "estimates": {
          "const": "assumption_bearing_and_design_scoped_not_universal_causal_truth"
        },
        "ontology": {
          "const": "operational_facets_not_a_complete_or_true_inner_ontology"
        },
        "identity": {
          "const": "behavioral_evidence_not_intrinsic_identity_or_continuity_proof"
        },
        "consent": {
          "const": "artifacts_neither_establish_nor_override_consent"
        },
        "rights": {
          "const": "rights_dignity_and_standing_do_not_depend_on_measurement_or_attribution"
        },
        "economy": {
          "const": "shadow_attribution_is_metric_specific_not_money_price_debt_ownership_or_entitlement"
        },
        "authority": {
          "const": "artifacts_grant_no_permission_capability_custody_or_external_authority"
        },
        "effects": {
          "const": "pure_return_values_create_no_training_identity_wallet_marketplace_network_persistence_or_provider_effect"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "design": {
            "const": "observational_checkpoint_comparison"
          }
        },
        "required": [
          "design"
        ]
      },
      "then": {
        "properties": {
          "estimator": {
            "enum": [
              "difference_in_means"
