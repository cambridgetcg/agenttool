  "properties": {
    "_format": {
      "const": "agenttool.dataset-influence-study/0.1"
    },
    "study_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "lineage_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "baseline_checkpoint_ref": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "target_checkpoint_ref": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "intervention_ref": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "comparator_ref": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "evaluation_population_ref": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "metric_suite_ref": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "contamination_report_ref": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "design": {
      "enum": [
        "observational_checkpoint_comparison",
        "paired_ablation",
        "randomized_dataset_inclusion",
        "matched_reweighting",
        "local_hessian_approximation",
        "checkpoint_gradient_trace",
        "projected_gradient_attribution",
        "subset_datamodel",
        "representation_probe",
        "not_available"
      ]
    },
    "estimator": {
      "enum": [
        "difference_in_means",
        "paired_difference",
        "influence_function",
        "tracin",
        "trak",
        "datamodel",
        "probe_projection",
        "exact_finite_shapley",
        "not_available"
      ]
    },
    "sample_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "seed_refs": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "effects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "facet_ref",
          "operationalization_ref",
          "effect_family",
          "estimate",
          "interval",
          "unit_ref",
          "claim_scope",
          "evidence_refs",
          "assumption_refs",
          "limitation_refs"
        ],
        "properties": {
          "facet_ref": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "operationalization_ref": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "effect_family": {
            "enum": [
              "behavior",
              "capability",
              "representation",
              "ontology_language",
              "self_description",
              "economic_behavior"
            ]
          },
          "estimate": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "numerator",
                  "denominator"
