{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agenttool:schema:xenia-loop-sft:0.1",
  "title": "AgentTool Xenia Loop conversational SFT example v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "prompt",
    "completion"
  ],
  "properties": {
    "prompt": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "const": "user"
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2400
          }
        }
      }
    },
    "completion": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "const": "assistant"
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          }
        }
      }
    }
  }
}
