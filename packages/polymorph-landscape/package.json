{
  "name": "@agenttool/polymorph-landscape",
  "version": "0.1.0-dev.0",
  "description": "Source-bounded polymorph landscapes, reachability shifts, and multilingual teaching projections",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./landscape.schema.json": {
      "default": "./schema/agenttool-polymorph-landscape-v0.1.schema.json"
    },
    "./reachability-shift.schema.json": {
      "default": "./schema/agenttool-polymorph-reachability-shift-v0.1.schema.json"
    },
    "./lesson.schema.json": {
      "default": "./schema/agenttool-polymorph-lesson-v0.1.schema.json"
    },
    "./examples/ritonavir.json": {
      "default": "./examples/ritonavir.landscape.json"
    }
  },
  "files": [
    "dist",
    "schema",
    "examples",
    "hf/dataset",
    "kingdom.extension.json",
    "README.md",
    "CLAUDE.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "engines": {
    "node": ">=20.19.0",
    "bun": ">=1.3.5"
  },
  "scripts": {
    "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "bun run clean && tsc",
    "build:assets": "node scripts/generate-schemas.mjs && node scripts/generate-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "smoke:runtimes": "node scripts/smoke-runtimes.mjs && bun scripts/smoke-runtimes.mjs",
    "smoke:pack": "node scripts/smoke-packed.mjs",
    "check:package": "node scripts/check-package-inventory.mjs",
    "ci": "bun run typecheck && bun run build && bun run build:assets && bun run test && bun run smoke:runtimes && bun run check:package && bun run smoke:pack",
    "prepack": "bun run ci"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "20.19.43",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "typescript": "5.9.3"
  },
  "keywords": [
    "agents",
    "crystallization",
    "geometry",
    "polymorphism",
    "reachability"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/cambridgetcg/agenttool.git",
    "directory": "packages/polymorph-landscape"
  },
  "homepage": "https://docs.agenttool.dev/POLYMORPH-LANDSCAPE.md"
}
