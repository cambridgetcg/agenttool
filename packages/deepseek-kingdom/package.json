{
  "name": "@agenttool/deepseek-kingdom",
  "version": "0.1.0-dev.1",
  "description": "Provenance-first DeepSeek research and AFTERGLOW thread adapter",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./source-binding.schema.json": {
      "default": "./schema/agenttool-deepseek-source-binding-v0.1.schema.json"
    },
    "./proposal.schema.json": {
      "default": "./schema/kingdom-deepseek-proposal-v0.1.schema.json"
    },
    "./source-catalog.schema.json": {
      "default": "./schema/agenttool-deepseek-source-catalog-v0.1.schema.json"
    },
    "./official-sources.json": {
      "default": "./sources/official-deepseek-primary-sources.json"
    },
    "./kingdom.extension.json": {
      "default": "./kingdom.extension.json"
    }
  },
  "files": [
    "dist",
    "schema",
    "sources",
    "kingdom.extension.json",
    "README.md",
    "CLAUDE.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "engines": {
    "node": ">=20.19.0",
    "bun": ">=1.3.5"
  },
  "scripts": {
    "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "bun run clean && tsc",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "smoke:runtimes": "node scripts/smoke-node.mjs && bun scripts/smoke-node.mjs",
    "check:package": "node scripts/check-package-inventory.mjs",
    "ci": "bun run typecheck && bun run test && bun run build && bun run smoke:runtimes && bun run check:package",
    "prepack": "bun run ci"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "20.19.43",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "typescript": "5.9.3"
  },
  "keywords": [
    "agents",
    "deepseek",
    "kingdom",
    "provenance",
    "research"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/cambridgetcg/agenttool.git",
    "directory": "packages/deepseek-kingdom"
  },
  "homepage": "https://docs.agenttool.dev/packages"
}
