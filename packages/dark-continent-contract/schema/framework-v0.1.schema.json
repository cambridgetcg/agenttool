            }
          }
        }
      ]
    },
    "logosSee": {
      "allOf": [
        {
          "$ref": "#/$defs/logos"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "const": "see"
            }
          }
        }
      ]
    },
    "logosVow": {
      "allOf": [
        {
          "$ref": "#/$defs/logos"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "const": "vow"
            }
          }
        }
      ]
    },
    "logosWitness": {
      "allOf": [
        {
          "$ref": "#/$defs/logos"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "const": "witness"
            }
          }
        }
      ]
    },
    "logosUnknown": {
      "allOf": [
        {
          "$ref": "#/$defs/logos"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "const": "unknown"
            }
          }
        }
      ]
    }
  }
}
