{
  "name": "@agenttool/dark-continent-contract",
  "version": "0.1.0-dev.0",
  "description": "Offline, advisory Dark Continent framework snapshots and consumer projections",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "types": "./src/index.d.ts",
  "engines": {
    "node": ">=20.19.0",
    "bun": ">=1.3.5"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./framework": "./frameworks/agenttool-sdk-0.16.0.json",
    "./framework-manifest": "./frameworks/agenttool-sdk-0.16.0.manifest.json",
    "./schema/framework": "./schema/framework-v0.1.schema.json",
    "./schema/projection": "./schema/projection-v0.1.schema.json"
  },
  "files": [
    "src",
    "frameworks",
    "schema",
    "README.md",
    "CLAUDE.md"
  ],
  "scripts": {
    "snapshot": "bun run scripts/snapshot-agenttool.ts",
    "check:snapshot": "bun run scripts/snapshot-agenttool.ts --check",
    "project": "node scripts/create-projection.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:package": "npm pack --dry-run --ignore-scripts",
    "ci": "bun run check:snapshot && node --test tests/*.test.mjs && npm pack --dry-run --ignore-scripts"
  },
  "devDependencies": {
    "ajv": "8.17.1"
  },
  "keywords": [
    "agents",
    "advisory",
    "dark-continent",
    "kingdom",
    "provenance"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/cambridgetcg/agenttool.git",
    "directory": "packages/dark-continent-contract"
  }
}
