{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agenttool:hf-scout:search:v0.1",
  "title": "AgentTool Hugging Face Scout search report",
  "$comment": "This schema closes the JSON shape. Runtime construction additionally binds every hit kind to the query kind and limits hit count to query.limit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "tool",
    "operation",
    "observed_at",
    "status",
    "transport",
    "query",
    "hits",
    "diagnostics"
  ],
  "properties": {
    "schema": {
      "const": "agenttool-hf-scout-search/v0.1"
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "const": "@agenttool/hf-scout"
        },
        "version": {
          "const": "0.1.0-dev.0"
        }
      }
    },
    "operation": {
      "const": "search"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    },
    "status": {
      "enum": ["observed", "partial"]
    },
    "transport": {
      "enum": ["public_hub_api", "injected"]
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "text", "limit"],
      "properties": {
        "kind": {
          "$ref": "#/$defs/repoKind"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "hits": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/hit"
      }
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "observed"
          }
        }
      },
      "then": {
        "properties": {
          "diagnostics": {
            "type": "array",
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "partial"
          }
        }
      },
      "then": {
        "properties": {
          "diagnostics": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "repoKind": {
      "enum": ["model", "dataset", "space", "paper"]
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "level", "message"],
      "properties": {
        "code": {
          "enum": [
            "content_commitments_partial",
            "declared_relations_truncated",
            "file_inventory_truncated",
            "file_inventory_unavailable",
            "license_unknown",
            "revision_unresolved",
            "search_entries_omitted",
            "search_metadata_truncated",
            "search_truncated",
            "tags_omitted",
            "tags_truncated"
          ]
        },
        "level": {
          "const": "warning"
        },
        "message": {
          "type": "string",
          "maxLength": 256
        }
      }
    },
    "hit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "full_sha",
        "license_declared",
        "task_declared",
        "library_declared",
        "gated_declared",
        "private_observed"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/repoKind"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 193
        },
        "full_sha": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{40}$"
        },
        "license_declared": {
          "type": ["string", "null"],
          "maxLength": 128
        },
        "task_declared": {
          "type": ["string", "null"],
          "maxLength": 128
        },
        "library_declared": {
          "type": ["string", "null"],
          "maxLength": 128
        },
        "gated_declared": {
          "enum": [true, false, "auto", "manual", null]
        },
        "private_observed": {
          "type": ["boolean", "null"]
        }
      }
    }
  }
}
