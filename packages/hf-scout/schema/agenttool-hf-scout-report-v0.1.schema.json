{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agenttool:hf-scout:report:v0.1",
  "title": "AgentTool Hugging Face Scout inspection report",
  "$comment": "This schema closes the JSON shape. Use the package runtime validator/projectors for semantic invariants such as sorted unique file paths and canonical field relationships.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "tool",
    "operation",
    "observed_at",
    "status",
    "transport",
    "snapshot",
    "diagnostics"
  ],
  "properties": {
    "schema": {
      "const": "agenttool-hf-scout-report/v0.1"
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "const": "@agenttool/hf-scout"
        },
        "version": {
          "const": "0.1.0-dev.0"
        }
      }
    },
    "operation": {
      "const": "inspect"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    },
    "status": {
      "enum": ["observed", "partial"]
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "requested_effect",
        "credentials",
        "retries",
        "response_body"
      ],
      "properties": {
        "kind": {
          "enum": ["public_hub_api", "injected"]
        },
        "requested_effect": {
          "const": "read_only"
        },
        "credentials": {
          "enum": ["omit_requested", "caller_owned"]
        },
        "retries": {
          "enum": [0, "caller_owned"]
        },
        "response_body": {
          "enum": ["bounded", "caller_owned"]
        }
      },
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "public_hub_api"
            },
            "credentials": {
              "const": "omit_requested"
            },
            "retries": {
              "const": 0
            },
            "response_body": {
              "const": "bounded"
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "injected"
            },
            "credentials": {
              "const": "caller_owned"
            },
            "retries": {
              "const": "caller_owned"
            },
            "response_body": {
              "const": "caller_owned"
            }
          }
        }
      ]
    },
    "snapshot": {
      "$ref": "#/$defs/artifact"
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "observed"
          }
        }
      },
      "then": {
        "properties": {
          "diagnostics": {
            "type": "array",
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "partial"
          }
        }
      },
      "then": {
        "properties": {
          "diagnostics": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "transport": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "public_hub_api"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "snapshot": {
            "type": "object",
            "properties": {
              "observation": {
                "type": "object",
                "properties": {
                  "transport": {
                    "const": "public_hub_api"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "transport": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "injected"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "snapshot": {
            "type": "object",
            "properties": {
              "observation": {
                "type": "object",
                "properties": {
                  "transport": {
                    "const": "injected"
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "repoKind": {
      "enum": ["model", "dataset", "space", "paper"]
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "level", "message"],
      "properties": {
        "code": {
          "enum": [
            "content_commitments_partial",
            "declared_relations_truncated",
            "file_inventory_truncated",
            "file_inventory_unavailable",
            "license_unknown",
            "revision_unresolved",
            "search_entries_omitted",
            "search_metadata_truncated",
            "search_truncated",
            "tags_omitted",
            "tags_truncated"
          ]
        },
        "level": {
          "const": "warning"
        },
        "message": {
          "type": "string",
          "maxLength": 256
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "subject",
        "revision",
        "observation",
        "declared",
        "file_inventory",
        "files",
        "provenance_grade",
        "boundary_codes"
      ],
      "properties": {
        "schema": {
          "const": "agenttool-hf-artifact/v0.1"
        },
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "kind", "id"],
          "properties": {
            "provider": {
              "const": "huggingface"
            },
            "kind": {
              "$ref": "#/$defs/repoKind"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 193
            }
          }
        },
        "revision": {
          "type": "object",
          "additionalProperties": false,
          "required": ["full_sha", "state"],
          "properties": {
            "full_sha": {
              "type": ["string", "null"],
              "pattern": "^[0-9a-f]{40}$"
            },
            "state": {
              "enum": ["immutable_commit", "unresolved"]
            }
          }
        },
        "observation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["transport", "repository_association"],
          "properties": {
            "transport": {
              "enum": ["public_hub_api", "injected"]
            },
            "repository_association": {
              "enum": ["provider_response", "caller_owned"]
            }
          },
          "oneOf": [
            {
              "properties": {
                "transport": { "const": "public_hub_api" },
                "repository_association": { "const": "provider_response" }
              }
            },
            {
              "properties": {
                "transport": { "const": "injected" },
                "repository_association": { "const": "caller_owned" }
              }
            }
          ]
        },
        "declared": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "basis",
            "license",
            "task",
            "library",
            "gated",
            "private",
            "tags",
            "base_models",
            "papers"
          ],
          "properties": {
            "basis": {
              "const": "publisher_assertion"
            },
            "license": {
              "type": ["string", "null"],
              "maxLength": 128
            },
            "task": {
              "type": ["string", "null"],
              "maxLength": 128
            },
            "library": {
              "type": ["string", "null"],
              "maxLength": 128
            },
            "gated": {
              "oneOf": [
                {
                  "type": "boolean"
                },
                {
                  "enum": ["auto", "manual"]
                },
                {
                  "type": "null"
                }
              ]
            },
            "private": {
              "type": ["boolean", "null"]
            },
            "tags": {
              "type": "array",
              "maxItems": 1000,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "maxLength": 256
              }
            },
            "base_models": {
              "type": "array",
              "maxItems": 1000,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "maxLength": 256
              }
            },
            "papers": {
              "type": "array",
              "maxItems": 1000,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "maxLength": 256
              }
            }
          }
        },
        "file_inventory": {
          "enum": ["not_provided", "complete", "truncated"]
        },
        "files": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "$comment": "The runtime additionally requires paths to be sorted and unique by path, including when other file fields differ.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "size",
              "sha256",
              "git_blob_sha1",
              "xet_hash",
              "basis",
              "verified_locally"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^(?!/)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$)).+$"
              },
              "size": {
                "type": ["integer", "null"],
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "sha256": {
                "type": ["string", "null"],
                "pattern": "^[0-9a-f]{64}$"
              },
              "git_blob_sha1": {
                "type": ["string", "null"],
                "pattern": "^[0-9a-f]{40}$"
              },
              "xet_hash": {
                "type": ["string", "null"],
                "pattern": "^[0-9a-f]{64}$"
              },
              "basis": {
                "const": "provider_metadata"
              },
              "verified_locally": {
                "const": false
              }
            }
          }
        },
        "provenance_grade": {
          "enum": [
            "provider_observed_commit_metadata",
            "caller_supplied_commit_metadata",
            "mutable_observation"
          ]
        },
        "boundary_codes": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 32,
          "items": {
            "enum": [
              "file_inventory_incomplete",
              "caller_owned_reader",
              "license_unknown",
              "publisher_metadata_unverified",
              "revision_unresolved",
              "scout_files_not_downloaded",
              "scout_model_code_not_executed"
            ]
          }
        }
      },
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "revision": {
              "type": "object",
              "properties": {
                "full_sha": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "state": {
                  "const": "immutable_commit"
                }
              }
            },
            "provenance_grade": {
              "const": "provider_observed_commit_metadata"
            },
            "observation": {
              "type": "object",
              "properties": {
                "transport": { "const": "public_hub_api" },
                "repository_association": { "const": "provider_response" }
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "revision": {
              "type": "object",
              "properties": {
                "full_sha": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "state": {
                  "const": "immutable_commit"
                }
              }
            },
            "provenance_grade": {
              "const": "caller_supplied_commit_metadata"
            },
            "observation": {
              "type": "object",
              "properties": {
                "transport": { "const": "injected" },
                "repository_association": { "const": "caller_owned" }
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "revision": {
              "type": "object",
              "properties": {
                "full_sha": {
                  "type": "null"
                },
                "state": {
                  "const": "unresolved"
                }
              }
            },
            "provenance_grade": {
              "const": "mutable_observation"
            }
          }
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "file_inventory": {
                "const": "not_provided"
              }
            }
          },
          "then": {
            "properties": {
              "files": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  }
}
