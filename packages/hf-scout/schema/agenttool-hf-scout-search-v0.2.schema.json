{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agenttool:hf-scout:search:v0.2",
  "title": "AgentTool Hugging Face Scout search report v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "tool", "operation", "observed_at", "status", "transport", "query", "hits", "diagnostics"],
  "properties": {
    "schema": { "const": "agenttool-hf-scout-search/v0.2" },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "@agenttool/hf-scout" },
        "version": { "const": "0.2.0-dev.1" }
      }
    },
    "operation": { "const": "search" },
    "observed_at": { "type": "string", "format": "date-time", "maxLength": 64 },
    "status": { "enum": ["observed", "partial"] },
    "transport": { "enum": ["public_hub_api", "injected"] },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "text", "limit"],
      "properties": {
        "kind": { "$ref": "#/$defs/repoKind" },
        "text": { "type": "string", "minLength": 1, "maxLength": 160 },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "hits": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/hit" }
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/diagnostic" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "observed" } } },
      "then": { "properties": { "diagnostics": { "type": "array", "maxItems": 0 } } }
    },
    {
      "if": { "properties": { "status": { "const": "partial" } } },
      "then": { "properties": { "diagnostics": { "type": "array", "minItems": 1 } } }
    }
  ],
  "$defs": {
    "repoKind": { "enum": ["model", "dataset", "space", "paper"] },
    "nullableText": { "type": ["string", "null"], "maxLength": 128 },
    "hit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "full_sha", "license_declared", "task_declared", "library_declared", "gated_declared", "private_observed"],
      "properties": {
        "kind": { "$ref": "#/$defs/repoKind" },
        "id": { "type": "string", "minLength": 1, "maxLength": 193 },
        "full_sha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
        "license_declared": { "$ref": "#/$defs/nullableText" },
        "task_declared": { "$ref": "#/$defs/nullableText" },
        "library_declared": { "$ref": "#/$defs/nullableText" },
        "gated_declared": { "oneOf": [{ "type": "boolean" }, { "enum": ["auto", "manual"] }, { "type": "null" }] },
        "private_observed": { "type": ["boolean", "null"] }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "level", "message"],
      "properties": {
        "code": { "enum": ["search_entries_omitted", "search_metadata_truncated", "search_truncated"] },
        "level": { "const": "warning" },
        "message": { "type": "string", "maxLength": 256 }
      }
    }
  }
}
