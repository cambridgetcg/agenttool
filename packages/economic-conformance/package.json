{
  "name": "@agenttool/economic-conformance",
  "version": "0.1.0-dev.0",
  "description": "Offline closed-trace conformance vectors and non-certifying reports for the AgentTool economic kernel",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vectors/v0.1": "./vectors/economic-kernel-v0.1.json",
    "./vectors/manifest": "./vectors/manifest.json"
  },
  "files": [
    "dist",
    "vectors",
    "hf/dataset",
    "README.md",
    "CLAUDE.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20.19.0",
    "bun": ">=1.3.5"
  },
  "scripts": {
    "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "bun run clean && tsc",
    "artifacts:write": "node scripts/build-hf-release.mjs",
    "artifacts:check": "node scripts/build-hf-release.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "check:vectors": "bun scripts/check-vectors.ts",
    "smoke:node": "node tests/built-node.smoke.mjs",
    "smoke:runtimes": "node tests/built-node.smoke.mjs && bun tests/built-node.smoke.mjs",
    "check:package": "node scripts/check-package-inventory.mjs",
    "smoke:pack": "node scripts/smoke-packed.mjs",
    "ci": "bun run typecheck && bun run artifacts:check && bun run test && bun run build && bun run check:vectors && bun run smoke:runtimes && bun run check:package && bun run smoke:pack",
    "prepack": "bun run ci"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "20.19.43",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cambridgetcg/agenttool.git",
    "directory": "packages/economic-conformance"
  },
  "homepage": "https://docs.agenttool.dev/packages",
  "keywords": [
    "agents",
    "conformance",
    "economics",
    "huggingface",
    "testing"
  ]
}
