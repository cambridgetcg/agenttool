{
  "name": "@agenttool/kingdom",
  "version": "0.1.1",
  "description": "Pure, read-only KINGDOM project cards, registries, and XENIA Surface helpers",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./card.schema.json": {
      "default": "./schema/agenttool-kingdom-card-v0.1.schema.json"
    },
    "./registry.schema.json": {
      "default": "./schema/agenttool-kingdom-registry-v0.1.schema.json"
    }
  },
  "bin": {
    "agenttool-kingdom": "dist/bin.js"
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_LICENSES"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.5"
  },
  "sideEffects": false,
  "scripts": {
    "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "bun run clean && tsc && node --eval \"require('node:fs').chmodSync('dist/bin.js', 0o755)\"",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "ci": "bun run typecheck && bun run build && bun test",
    "prepack": "bun run ci",
    "prepublishOnly": "bun run ci"
  },
  "dependencies": {
    "@agenttool/xenia": "0.1.0-beta.7"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "agents",
    "kingdom",
    "project-registry",
    "xenia",
    "rights",
    "discovery"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/cambridgetcg/agenttool.git",
    "directory": "packages/kingdom"
  },
  "homepage": "https://docs.agenttool.dev/packages"
}
