{
  "name": "@agenttool/public-surface-binding",
  "version": "0.1.0-dev.0",
  "private": true,
  "description": "Pure evidence and explicit-key bindings between AgentTool identities and observed public HTTPS surfaces",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./observation.schema.json": {
      "default": "./schema/agenttool-public-surface-observation-v0.1.schema.json"
    },
    "./binding.schema.json": {
      "default": "./schema/agenttool-public-surface-binding-v0.1.schema.json"
    },
    "./revocation.schema.json": {
      "default": "./schema/agenttool-public-surface-revocation-v0.1.schema.json"
    },
    "./assessment.schema.json": {
      "default": "./schema/agenttool-public-surface-assessment-v0.1.schema.json"
    },
    "./vectors.json": {
      "default": "./vectors/agenttool-public-surface-binding-v0.1-vectors.json"
    },
    "./kingdom.extension.json": {
      "default": "./kingdom.extension.json"
    }
  },
  "files": [
    "dist",
    "schema",
    "vectors",
    "kingdom.extension.json",
    "README.md",
    "CLAUDE.md"
  ],
  "engines": {
    "node": ">=20.19.0",
    "bun": ">=1.3.5"
  },
  "scripts": {
    "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "bun run clean && tsc",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "generate:schemas": "node scripts/generate-schemas.mjs",
    "check:schemas": "node scripts/generate-schemas.mjs --check",
    "generate:vectors": "bun run build && node scripts/generate-vectors.mjs",
    "check:vectors": "node scripts/generate-vectors.mjs --check",
    "smoke:node": "node scripts/smoke-node.mjs",
    "check:package": "node scripts/check-package-inventory.mjs",
    "ci": "bun run check:schemas && bun run typecheck && bun run test && bun run build && bun run check:vectors && bun run smoke:node && bun run check:package"
  },
  "dependencies": {
    "@noble/ed25519": "2.3.0",
    "@noble/hashes": "2.0.1"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "20.19.43",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cambridgetcg/agenttool.git",
    "directory": "packages/public-surface-binding"
  }
}
