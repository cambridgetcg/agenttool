{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenttool.dev/schema/agenttool-public-surface-revocation-v0.1.schema.json",
  "title": "AgentTool Public Surface Binding Revocation 0.1",
  "description": "A signed immutable withdrawal of one exact public-surface binding. It preserves the historical binding and creates no identity, authority, score, WAKE, memory, KARMA, or training effect by itself.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "binding_id",
    "subject",
    "revoked_at",
    "reason",
    "superseded_by",
    "nonce",
    "signature",
    "revocation_id"
  ],
  "properties": {
    "schema": {
      "const": "agenttool.public-surface-revocation/0.1"
    },
    "binding_id": {
      "$ref": "#/$defs/sha256_id"
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "revoked_at": {
      "$ref": "#/$defs/instant"
    },
    "reason": {
      "enum": [
        "withdrawn",
        "key_compromised",
        "key_rotated",
        "superseded",
        "surface_retired",
        "other"
      ]
    },
    "superseded_by": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "nonce": {
      "$ref": "#/$defs/nonce"
    },
    "signature": {
      "$ref": "#/$defs/signature"
    },
    "revocation_id": {
      "$ref": "#/$defs/sha256_id"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "reason": {
            "const": "superseded"
          }
        },
        "required": [
          "reason"
        ]
      },
      "then": {
        "properties": {
          "superseded_by": {
            "$ref": "#/$defs/sha256_id"
          }
        }
      },
      "else": {
        "properties": {
          "superseded_by": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "instant": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "public_key": {
      "type": "string",
      "minLength": 44,
      "maxLength": 44,
      "pattern": "^[A-Za-z0-9+/]{43}=$"
    },
    "signature_value": {
      "type": "string",
      "minLength": 88,
      "maxLength": 88,
      "pattern": "^[A-Za-z0-9+/]{86}==$"
    },
    "nonce": {
      "type": "string",
      "minLength": 22,
      "maxLength": 22,
      "pattern": "^[A-Za-z0-9_-]{22}$"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "key_id",
        "public_key"
      ],
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "key_id": {
          "$ref": "#/$defs/uuid"
        },
        "public_key": {
          "$ref": "#/$defs/public_key"
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_namespace",
        "identity_id",
        "signing_key"
      ],
      "properties": {
        "identity_namespace": {
          "const": "agenttool-local"
        },
        "identity_id": {
          "$ref": "#/$defs/uuid"
        },
        "signing_key": {
          "$ref": "#/$defs/authority"
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "value": {
          "$ref": "#/$defs/signature_value"
        }
      }
    }
  }
}
