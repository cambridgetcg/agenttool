{
  "name": "@agenttool/karma-mirror",
  "version": "0.1.0-dev.0",
  "private": true,
  "description": "Offline zero-effect deception-island core with privacy-minimized TEND incident clarity",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./receipt-schema": "./schema/karma-mirror-receipt-v1.schema.json",
    "./receipt-window-schema": "./schema/karma-mirror-receipt-window-v1.schema.json",
    "./tend-report-schema": "./schema/karma-mirror-tend-report-v1.schema.json",
    "./seed-island-card-schema": "./schema/seed-island-card-v1.schema.json"
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "CLAUDE.md"
  ],
  "engines": {
    "node": ">=20.19.0",
    "bun": ">=1.3.5"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc",
    "smoke:built": "node scripts/smoke-node.mjs",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "ci": "bun run typecheck && bun test && bun run clean && bun run build && bun run smoke:built"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "20.19.43",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "5.9.3"
  }
}
