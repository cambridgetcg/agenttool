  "$defs": {
    "sha256_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "instant": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "did": {
      "type": "string",
      "pattern": "^did:at:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "maxLength": 43
    },
    "https_origin": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048,
      "pattern": "^https://[a-z0-9.-]+$"
    },
    "public_key": {
      "type": "string",
      "minLength": 44,
      "maxLength": 44,
      "pattern": "^[A-Za-z0-9+/]{43}=$"
    },
    "signature_value": {
      "type": "string",
      "minLength": 88,
      "maxLength": 88,
      "pattern": "^[A-Za-z0-9+/]{86}==$"
    },
    "nonce": {
      "type": "string",
      "minLength": 22,
      "maxLength": 22,
      "pattern": "^[A-Za-z0-9_-]{22}$"
    },
    "authority_sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "authority_root": {
      "type": "object",
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "public_key": {
          "$ref": "#/$defs/public_key"
        }
      },
      "required": [
        "algorithm",
        "public_key"
      ],
      "additionalProperties": false
    },
    "subject": {
      "type": "object",
      "properties": {
        "identity_namespace": {
          "const": "agenttool-local"
        },
        "identity_id": {
          "$ref": "#/$defs/uuid"
        },
        "did": {
          "$ref": "#/$defs/did"
        },
        "authority_root": {
          "$ref": "#/$defs/authority_root"
        }
      },
