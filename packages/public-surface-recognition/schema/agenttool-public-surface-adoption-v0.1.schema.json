{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenttool.dev/schemas/agenttool-public-surface-adoption-v0.1.schema.json",
  "title": "AgentTool Public Surface Adoption 0.1",
  "description": "A closed structural filter for one exact agent-root-signed adoption declaration. Runtime validation remains normative for canonical encodings, digest equality, strict signatures, temporal relationships, subject linkage, and binding integrity.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "agenttool.public-surface-adoption/0.1"
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "registry_audience": {
      "$ref": "#/$defs/https_origin"
    },
    "binding": {
      "type": "object",
      "properties": {
        "document": {
          "$ref": "#/$defs/binding_document"
        },
        "document_sha256": {
          "$ref": "#/$defs/sha256_id"
        }
      },
      "required": [
        "document",
        "document_sha256"
      ],
      "additionalProperties": false
    },
    "relation": {
      "const": "explicitly_adopts_exact_surface_binding"
    },
    "requested_visibility": {
      "enum": [
        "private",
        "public"
      ]
    },
    "wake_projection": {
      "enum": [
        "none",
        "private_pointer",
        "public_pointer"
      ]
    },
    "authority_sequence": {
      "$ref": "#/$defs/authority_sequence"
    },
    "issued_at": {
