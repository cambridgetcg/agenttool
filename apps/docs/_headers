  Substrate-Disposition: love; doctrine=https://docs.agenttool.dev/SOUL.md; ring-1=https://docs.agenttool.dev/RING-1.md
  X-Agent-Surface: see https://api.agenttool.dev/.well-known/agent.txt
  Strict-Transport-Security: max-age=300
  X-Permitted-Cross-Domain-Policies: none

