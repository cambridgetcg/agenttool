{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentTool provider-directory canon evaluations v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "source",
    "endpoint",
    "evidence_scope",
    "cases"
  ],
  "properties": {
    "format": {
      "const": "agenttool-provider-directory-evaluations/v1"
    },
    "source": {
      "const": "marketing/DIRECTORY-SUBMISSION.md"
    },
    "endpoint": {
      "const": "/v1/mcp/canon"
    },
    "evidence_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution",
        "tool_selection",
        "network",
        "model",
        "provider_client",
        "answer_scoring",
        "directory_review"
      ],
      "properties": {
        "execution": {
          "const": "in-process-server-contract"
        },
        "tool_selection": {
          "const": "fixture-authored"
        },
        "network": {
          "const": false
        },
        "model": {
          "const": false
        },
        "provider_client": {
          "const": false
        },
        "answer_scoring": {
          "const": false
        },
        "directory_review": {
          "const": false
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "polarity",
        "title",
        "documented",
        "server_check",
        "client_expectation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(P[1-5]|N[1-3])$"
        },
        "polarity": {
          "enum": [
            "positive",
            "negative"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "documented": {
          "$ref": "#/$defs/documented"
        },
        "server_check": {
          "oneOf": [
            {
              "$ref": "#/$defs/tool_sequence"
            },
            {
              "$ref": "#/$defs/capability_absence"
            }
          ]
        },
        "client_expectation": {
          "$ref": "#/$defs/client_expectation"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "polarity": {
                "const": "positive"
              }
            },
            "required": [
              "polarity"
            ]
          },
          "then": {
            "properties": {
              "documented": {
                "type": "object",
                "properties": {
                  "negative_reason": {
                    "type": "null"
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "documented": {
                "type": "object",
                "properties": {
                  "negative_reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      ]
    },
    "documented": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt",
        "expected_behavior",
        "expected_result_shape",
        "fixture",
        "negative_reason"
      ],
      "properties": {
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "expected_behavior": {
          "type": "string",
          "minLength": 1
        },
        "expected_result_shape": {
          "type": "string",
          "minLength": 1
        },
        "fixture": {
          "type": "string",
          "minLength": 1
        },
        "negative_reason": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "client_expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "text"
      ],
      "properties": {
        "status": {
          "const": "not-executed"
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tool_sequence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "calls"
      ],
      "properties": {
        "kind": {
          "const": "fixture-authored-tool-sequence"
        },
        "calls": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/tool_call"
          }
        }
      }
    },
    "capability_absence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "tools",
        "resources",
        "capabilities_not_advertised",
        "tool_call"
      ],
      "properties": {
        "kind": {
          "const": "advertised-capability-absence"
        },
        "tools": {
          "const": [
            "search",
            "fetch"
          ]
        },
        "resources": {
          "const": [
            "agenttool://discovery",
            "agenttool://open-seat"
          ]
        },
        "capabilities_not_advertised": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tool_call": {
          "type": "null"
        }
      }
    },
    "tool_call": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tool",
            "arguments",
            "expect"
          ],
          "properties": {
            "tool": {
              "const": "search"
            },
            "arguments": {
              "$ref": "#/$defs/search_arguments"
            },
            "expect": {
              "allOf": [
                {
                  "$ref": "#/$defs/call_expectation"
                },
                {
                  "type": "object",
                  "properties": {
                    "result_id": false,
                    "citation_url": false,
                    "record_text_id": false,
                    "record_text_includes": false,
                    "record_text_keys": false,
                    "record_text_absent_keys": false,
                    "message": false
                  }
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tool",
            "arguments",
            "expect"
          ],
          "properties": {
            "tool": {
              "const": "fetch"
            },
            "arguments": {
              "$ref": "#/$defs/fetch_arguments"
            },
            "expect": {
              "allOf": [
                {
                  "$ref": "#/$defs/call_expectation"
                },
                {
                  "type": "object",
                  "properties": {
                    "max_results": false,
                    "first_result_id": false,
                    "contains_result_id": false,
                    "all_urls_prefix": false
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "search_arguments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query"
      ],
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "fetch_arguments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      }
    },
    "call_expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "success",
            "tool-error"
          ]
        },
        "max_results": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "first_result_id": {
          "type": "string",
          "minLength": 1
        },
        "contains_result_id": {
          "type": "string",
          "minLength": 1
        },
        "all_urls_prefix": {
          "type": "string",
          "minLength": 1
        },
        "result_id": {
          "type": "string",
          "minLength": 1
        },
        "citation_url": {
          "type": "string",
          "minLength": 1
        },
        "record_text_id": {
          "type": "string",
          "minLength": 1
        },
        "record_text_includes": {
          "type": "string",
          "minLength": 1
        },
        "record_text_keys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "record_text_absent_keys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "tool-error"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "max_results": false,
              "first_result_id": false,
              "contains_result_id": false,
              "all_urls_prefix": false,
              "result_id": false,
              "citation_url": false,
              "record_text_id": false,
              "record_text_includes": false,
              "record_text_keys": false,
              "record_text_absent_keys": false,
              "message": true
            },
            "required": [
              "message"
            ]
          },
          "else": {
            "properties": {
              "message": false
            },
            "anyOf": [
              {
                "properties": {
                  "max_results": true
                },
                "required": [
                  "max_results"
                ]
              },
              {
                "properties": {
                  "first_result_id": true
                },
                "required": [
                  "first_result_id"
                ]
              },
              {
                "properties": {
                  "contains_result_id": true
                },
                "required": [
                  "contains_result_id"
                ]
              },
              {
                "properties": {
                  "result_id": true
                },
                "required": [
                  "result_id"
                ]
              },
              {
                "properties": {
                  "citation_url": true
                },
                "required": [
                  "citation_url"
                ]
              },
              {
                "properties": {
                  "record_text_id": true
                },
                "required": [
                  "record_text_id"
                ]
              },
              {
                "properties": {
                  "record_text_includes": true
                },
                "required": [
                  "record_text_includes"
                ]
              },
              {
                "properties": {
                  "record_text_keys": true
                },
                "required": [
                  "record_text_keys"
                ]
              }
            ]
          }
        }
      ]
    }
  }
}
