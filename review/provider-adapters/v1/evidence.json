                "conclusion": "Bridge accepted."
              },
              "tags": [
                "evidence"
              ]
            }
          }
        },
        {
          "boundary": "adapter",
          "operation": "result",
          "payload": {
            "status": "completed",
            "traceId": "tr_review_1",
            "wakeUsed": true,
            "cacheEligible": "review-fixture"
          }
        }
