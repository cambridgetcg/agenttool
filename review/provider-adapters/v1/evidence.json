  "vocabulary": {
    "providers": [
      "openai",
      "anthropic"
    ],
    "languages": [
      "typescript",
      "python"
    ],
    "lifecycles": [
      "completed",
      "low-level-stream",
      "managed-stream",
      "refused"
    ],
    "boundaries": [
      "agenttool.wake",
      "agenttool.write",
      "provider.openai.responses",
      "provider.anthropic.messages",
      "provider.anthropic.stream",
      "adapter"
    ],
    "operations": [
      "system",
      "create",
      "stream",
      "final-message",
      "abort",
      "result",
      "refuse"
    ],
    "dataClasses": [
      "wake-text",
      "caller-instructions",
      "caller-prompt",
      "provider-metadata",
      "provider-response",
      "provider-stream-event",
      "prompt-excerpt",
      "response-excerpt",
      "parsed-chronicle",
      "parsed-trace",
      "local-receipt"
    ],
    "flowEndpoints": [
      "provider-client",
      "agenttool-wake",
      "agenttool-traces",
      "agenttool-chronicle",
      "caller-process",
      "adapter-process"
    ],
    "controlKinds": [
      "enforced-local",
      "requested-upstream"
    ]
  },
  "normalization": {
    "fieldNames": "camelCase",
    "omittedIdentityId": null,
    "omittedWakeProfile": "full",
    "payloadRule": "Event payloads preserve the exact normalized JSON value for each fixture. The schema closes event envelopes and vocabularies; both replay tests bind every normalized payload value and structure exactly.",
    "resultRule": "Adapter result events are test projections of local receipts and counters, never provider responses or upstream attestations."
  },
  "flows": [
    {
      "id": "wake-to-provider",
      "providers": [
        "openai",
        "anthropic"
      ],
      "lifecycles": [
        "completed",
        "low-level-stream",
        "managed-stream"
      ],
      "when": "wake injection is not skipped",
      "dataClasses": [
        "wake-text"
      ],
      "source": "agenttool-wake",
      "destination": "provider-client"
    },
    {
      "id": "caller-request-to-provider",
      "providers": [
        "openai",
        "anthropic"
      ],
      "lifecycles": [
        "completed",
        "low-level-stream",
        "managed-stream"
      ],
      "when": "local validation and any wake lookup complete",
      "dataClasses": [
        "caller-instructions",
        "caller-prompt",
        "provider-metadata"
      ],
      "source": "caller-process",
      "destination": "provider-client"
    },
    {
      "id": "provider-response-to-caller",
      "providers": [
        "openai",
        "anthropic"
      ],
      "lifecycles": [
        "completed",
        "managed-stream"
      ],
      "when": "the supplied provider client returns data",
      "dataClasses": [
        "provider-response"
      ],
      "source": "provider-client",
      "destination": "caller-process"
    },
    {
      "id": "provider-stream-event-to-caller",
      "providers": [
        "anthropic"
      ],
      "lifecycles": [
        "low-level-stream",
        "managed-stream"
      ],
      "when": "the supplied provider client yields a stream event",
      "dataClasses": [
        "provider-stream-event"
      ],
      "source": "provider-client",
      "destination": "caller-process"
    },
    {
      "id": "local-receipt-to-caller",
      "providers": [
        "openai",
        "anthropic"
      ],
      "lifecycles": [
        "completed",
        "low-level-stream",
        "managed-stream"
      ],
      "when": "the adapter returns a response or stream facade",
      "dataClasses": [
        "local-receipt"
      ],
      "source": "adapter-process",
      "destination": "caller-process"
    },
    {
      "id": "opt-in-trace-to-agenttool",
      "providers": [
        "openai",
        "anthropic"
      ],
      "lifecycles": [
        "completed",
        "managed-stream"
      ],
      "when": "decision tracing is explicitly requested or an ambient deciding scope exists, and completion succeeds",
      "dataClasses": [
        "prompt-excerpt",
        "response-excerpt"
      ],
      "source": "adapter-process",
      "destination": "agenttool-traces"
    },
    {
      "id": "anthropic-chronicle-markup-to-agenttool",
      "providers": [
        "anthropic"
      ],
      "lifecycles": [
        "completed",
        "managed-stream"
      ],
      "when": "a completed response contains supported AgentTool markup and parsing is not disabled",
      "dataClasses": [
        "parsed-chronicle"
      ],
      "source": "adapter-process",
      "destination": "agenttool-chronicle"
    },
    {
      "id": "anthropic-trace-markup-to-agenttool",
      "providers": [
        "anthropic"
      ],
      "lifecycles": [
        "completed",
        "managed-stream"
      ],
      "when": "a completed response contains supported AgentTool trace markup and parsing is not disabled",
      "dataClasses": [
        "parsed-trace"
      ],
      "source": "adapter-process",
      "destination": "agenttool-traces"
    }
  ],
  "controls": [
    {
      "id": "local-agenttool-metadata-stripped",
      "providers": [
        "openai",
        "anthropic"
      ],
      "kind": "enforced-local",
      "statement": "metadata.agenttool is adapter control data and is removed before the supplied provider client is called."
    },
    {
      "id": "openai-omitted-store-false",
      "providers": [
        "openai"
      ],
      "kind": "requested-upstream",
      "statement": "An omitted OpenAI store field is sent as false. This is a request field, not proof of provider retention or deletion."
    },
    {
      "id": "openai-explicit-store-preserved",
      "providers": [
        "openai"
      ],
      "kind": "enforced-local",
      "statement": "An explicit caller store value is forwarded unchanged. This proves adapter preservation only, not provider retention behavior."
    },
    {
      "id": "openai-stream-background-refused",
      "providers": [
        "openai"
      ],
      "kind": "enforced-local",
      "statement": "OpenAI streaming and background requests are refused before wake or provider I/O."
    },
    {
      "id": "anthropic-wake-block-order",
      "providers": [
        "anthropic"
      ],
      "kind": "enforced-local",
      "statement": "Anthropic wake system blocks precede caller system blocks."
    },
    {
      "id": "anthropic-ephemeral-cache-request",
      "providers": [
        "anthropic"
      ],
      "kind": "requested-upstream",
      "statement": "A wake block marked cache_control ephemeral is passed to the supplied provider client. This is a cache request, not proof of upstream retention behavior."
    },
    {
      "id": "anthropic-low-level-no-final-effects",
      "providers": [
        "anthropic"
      ],
      "kind": "enforced-local",
      "statement": "Low-level messages.create streaming passes events through without final-response tracing or markup effects; a trace request is refused before I/O."
    },
    {
      "id": "anthropic-managed-terminal-fence",
      "providers": [
        "anthropic"
      ],
      "kind": "enforced-local",
      "statement": "Managed streaming finalizes once after a provider final message; explicit cancellation before finalization fences later AgentTool effects."
    },
    {
      "id": "anthropic-model-authored-chronicle-gated",
      "providers": [
        "anthropic"
      ],
      "kind": "enforced-local",
      "statement": "A <chronicle> tag emitted by the model is written only after a caller-supplied beforeChronicleWrite hook returns literal true, and only through chronicle.write, which enforces the canonical type union and the 1-200 character title bound. With no hook installed the write is refused locally and no request is sent."
    }
  ],
  "cases": [
    {
