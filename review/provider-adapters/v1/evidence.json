      "lifecycle": "completed",
      "fixture": "openai.completed.default-store-trace",
      "proves": [
        "local-agenttool-metadata-stripped",
        "openai-omitted-store-false"
      ],
      "expectedTranscript": [
        {
          "boundary": "agenttool.wake",
          "operation": "system",
          "payload": {
            "provider": "openai",
            "identityId": null,
            "profile": "full"
          }
        },
        {
          "boundary": "provider.openai.responses",
          "operation": "create",
          "payload": {
            "model": "gpt-review-fixture",
            "input": "Review this bridge.",
            "instructions": "OPENAI_STABLE_WAKE\n\nOPENAI_VOLATILE_WAKE\n\nStay concise.",
            "metadata": {
              "tenant": "review-fixture"
            },
            "store": false
          }
        },
        {
          "boundary": "agenttool.write",
          "operation": "create",
          "payload": {
            "method": "POST",
            "path": "/v1/traces",
            "body": {
              "decision": {
                "type": "review",
