# Dependencies
node_modules/
node_modules
.pnpm-store/
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Build output. Two packages commit their MCP bundles; CI compares them with
# a fresh build.
dist/
!packages/collab/dist/
packages/collab/dist/*
!packages/collab/dist/agenttool-collab-mcp.js
!packages/collab/dist/agenttool-collab-host.js
!packages/telescope/dist/
packages/telescope/dist/*
!packages/telescope/dist/agenttool-telescope-mcp.js
build/
.next/
.turbo/
out/
*.tsbuildinfo
# Archives that `npm pack` writes inside a package directory.
packages/**/*.tgz

# Native SwiftPM scratch output
native/**/.build/
native/**/.swiftpm/

# Deploy staging: copies written into api/ for the image build and removed
# afterwards; never committed.
api/agenttool.jsonld.bundled
api/doctrine-docs.bundled/
api/kingdom-bundle.json.bundled
api/src/private/

